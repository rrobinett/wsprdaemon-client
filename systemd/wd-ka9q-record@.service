# /etc/systemd/system/wd-ka9q-record@.service
# KA9Q multicast recorder — one instance per receiver.
# Listens to one multicast stream, produces wav files for all component bands.
# Runs continuously — NEVER schedule-toggled.
#
# Instance name = receiver name, e.g.: wd-ka9q-record@KA9Q_0.service

[Unit]
Description=wsprdaemon KA9Q recorder for %i
After=network-online.target var-spool-wsprdaemon.mount
Wants=network-online.target
Requires=var-spool-wsprdaemon.mount
PartOf=wsprdaemon.target

[Service]
Type=simple
User=wsprdaemon
Group=radio
EnvironmentFile=-/etc/sigmond/coordination.env
EnvironmentFile=/etc/wsprdaemon/env/wd-ka9q-record@%i.env
ExecStart=/usr/local/sbin/wd-ka9q-record
WorkingDirectory=/var/spool/wsprdaemon/recording/%i

Restart=always
RestartSec=5
# Continuous runtime — no scheduled restart.  The historical
# `RuntimeMaxSec=45min` was a safety net for memory growth /
# processing-lag accumulation in pre-pipeline-v2 wspr-recorder
# (observed ~3s/min drift, capped under 135s by a 45-min reset).
# pipeline-v2 fixed those root causes (anchor-once timing + per-cycle
# CycleBatcher; no decode queue building up), and every 45-min restart
# was costing ~1 WSPR cycle of decodes (~30 missed spots × 32 restarts/day
# = ~1k spots/day on B4-100).  Disabled 2026-05-14.  If memory growth
# returns, prefer fixing the leak over reinstating this — see git blame
# for the original rationale.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wd-ka9q-record@%i

[Install]
WantedBy=wsprdaemon.target
