# /etc/systemd/system/wd-ka9q-record@.service
# KA9Q multicast recorder — one instance per receiver.
# Listens to one multicast stream, produces wav files for all component bands.
# Runs continuously — NEVER schedule-toggled.
#
# Instance name = receiver name, e.g.: wd-ka9q-record@KA9Q_0.service

[Unit]
Description=wsprdaemon KA9Q recorder for %i
After=network-online.target var-spool-wsprdaemon.mount
Wants=network-online.target
Requires=var-spool-wsprdaemon.mount
PartOf=wsprdaemon.target

[Service]
Type=simple
User=wsprdaemon
Group=radio
EnvironmentFile=-/etc/sigmond/coordination.env
EnvironmentFile=/etc/wsprdaemon/env/wd-ka9q-record@%i.env
# Per-instance recording subdir under the tmpfs spool — recreated on
# every boot because /var/spool/wsprdaemon is tmpfs.  `%i` is only known
# at unit-start time, so tmpfiles.d can't help here.  Runs as User=
# (wsprdaemon), which has write perms on the tmpfs (mode 1775).
ExecStartPre=/usr/bin/mkdir -p /var/spool/wsprdaemon/recording/%i
ExecStart=/usr/local/sbin/wd-ka9q-record
WorkingDirectory=/var/spool/wsprdaemon/recording/%i

Restart=always
RestartSec=5
# Safety-net restart at 4 hours.
#
# History: the original 45-min restart was added because of observed
# RSS climb at ~5-40 MB/min that would eventually OOM the host.  On
# 2026-05-14 the policy was disabled (commit 58d97da) believing that
# pipeline-v2's anchor-once timing + CycleBatcher had removed the root
# cause.  Same-day instrumentation showed the RSS climb is still real:
#
#   - tracemalloc current stays stable at ~407 MB (Python heap fine)
#   - RSS grows ~41 MB/min over many cycles (50 → 624 MB in 14 min)
#   - Disabling Transparent Huge Pages dropped AnonHugePages
#     411 MB → 2 MB but did NOT reduce the growth rate, ruling out
#     THP fragmentation as the cause.
#   - The ~220 MB gap between RSS and tracemalloc-tracked memory is
#     non-Python C allocations (numpy, subprocess pipes, sqlite, ...)
#     that aren't being released back to the OS even after Python
#     drops its references.
#
# Until the leak is identified and fixed, 4 h is a compromise:
#   - misses ~1 WSPR cycle per 4h = ~6 cycles/day = 0.8% loss
#     (vs. ~32/day = 4% under the old 45-min policy)
#   - bounds peak RSS to ~4 × 41 MB/min × 240 min = 1.6 GB / cycle of
#     ramp-up + accumulated baseline ≈ 2 GB before reset — comfortably
#     within the 7.8 GB host budget.
#
# When the real leak is fixed, this can return to continuous runtime.
RuntimeMaxSec=4h

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wd-ka9q-record@%i

[Install]
WantedBy=wsprdaemon.target
