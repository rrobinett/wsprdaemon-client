# /etc/systemd/system/wd-spool-clean.service
# Delete stale wav files from the recording spool.
# Different retention by file type:
#   *_IQ.wav  (WWV/CHU IQ) : 3 minutes  — I1 mode decodes each file independently
#   *_usr.wav (KA9Q WSPR)  : 32 minutes — F30 needs 30 consecutive 1-min files
#   *_usb.wav (Kiwi WSPR)  : 32 minutes — same F30 requirement
# When wd-decode is running it consumes files well within these windows
# and this janitor is a safety net only.
# Run by wd-spool-clean.timer every 5 minutes.

[Unit]
Description=wsprdaemon spool janitor
After=var-spool-wsprdaemon.mount
ConditionPathIsMountPoint=/var/spool/wsprdaemon

[Service]
Type=oneshot
User=wsprdaemon
ExecStart=/bin/bash -c '\
    find /var/spool/wsprdaemon/recording -name "*_IQ.wav"  -not -empty -mmin +3  -delete ; \
    find /var/spool/wsprdaemon/recording -name "*_usr.wav" -not -empty -mmin +32 -delete ; \
    find /var/spool/wsprdaemon/recording -name "*_usb.wav" -not -empty -mmin +32 -delete'
