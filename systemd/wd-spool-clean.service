# /etc/systemd/system/wd-spool-clean.service
# Smart per-band spool janitor.
# Retention per directory is derived from WD_RECEIVER_MODES in each band's
# env file: max(mode_window) + 2 min.  Typical values:
#   I1-only dirs (WWV/CHU IQ) →  3 min
#   W2/F2/F5    dirs          →  7 min
#   F15         dirs          → 17 min
#   F30         dirs          → 32 min
# Run by wd-spool-clean.timer every 5 minutes.

[Unit]
Description=wsprdaemon spool janitor
After=var-spool-wsprdaemon.mount
ConditionPathIsMountPoint=/var/spool/wsprdaemon

[Service]
Type=oneshot
User=wsprdaemon
ExecStart=/usr/local/sbin/wd-spool-clean
