#!/bin/bash
# /usr/local/sbin/wd-kiwi-cleanup
# Called by ExecStopPost= after wd-kiwi-record stops.
# kiwirecorder.py truncates the wav file it is currently writing when killed.
# We delete it to prevent the decoder from decoding an incomplete window.
#
# A complete 60-second PCM 16-bit 12kHz mono wav = 1,440,044 bytes.
# Any file smaller than this threshold is truncated and must be removed.

set -euo pipefail

INSTANCE="${1:?Usage: wd-kiwi-cleanup RECEIVER-BAND}"

RECEIVER="${INSTANCE%-*}"
BAND="${INSTANCE##*-}"
RECORDING_DIR="/var/spool/wsprdaemon/recording/${RECEIVER}/${BAND}"

# A full 60-second Kiwi wav: 12000 Hz * 60 s * 2 bytes + 44-byte header
FULL_SIZE=1440044
# Allow 2 seconds of missing audio at the end before flagging as truncated
MIN_COMPLETE=$(( FULL_SIZE - 12000 * 2 * 2 ))   # 48000 bytes = 2 sec

[[ -d "${RECORDING_DIR}" ]] || exit 0

# Find the most recently modified wav file
LATEST=$(find "${RECORDING_DIR}" -maxdepth 1 -name '*.wav' \
         -printf '%T@\t%p\n' 2>/dev/null | sort -rn | head -1 | cut -f2)

[[ -n "${LATEST}" ]] || exit 0

FILE_SIZE=$(stat -c%s "${LATEST}" 2>/dev/null || echo 0)

if (( FILE_SIZE < MIN_COMPLETE )); then
    echo "wd-kiwi-cleanup [${INSTANCE}]: removing truncated file (${FILE_SIZE} < ${MIN_COMPLETE} bytes): ${LATEST##*/}"
    rm -f "${LATEST}"
else
    echo "wd-kiwi-cleanup [${INSTANCE}]: most recent file is complete (${FILE_SIZE} bytes), keeping it"
fi
