#!/bin/bash
# /usr/local/sbin/wd-ka9q-record
# Thin wrapper — validates env vars and execs the Python recorder.
# Channel creation and wav recording are handled by wd-ka9q-record.py
# using ka9q-python (RadiodControl + ManagedStream).

set -euo pipefail

: "${WD_RECEIVER_NAME:?WD_RECEIVER_NAME not set}"
: "${WD_RADIOD_STATUS:?WD_RADIOD_STATUS not set}"
: "${WD_RECORDING_DIR:?WD_RECORDING_DIR not set}"
: "${WD_BANDS:?WD_BANDS not set}"

VENV_PYTHON=/opt/wsprdaemon/venv/bin/python3
RECORDER=/opt/wsprdaemon/bin/wd-ka9q-record.py

exec "${VENV_PYTHON}" "${RECORDER}"
