#!/usr/bin/env python3
"""wd-upload-wsprnet — upload WSPR spots to wsprnet.org via MEPT bulk transfer.

One instance per reporter CALL+GRID. Watches the upload queue directory for
spot files produced by wd-post, batches them (≤999 spots), sorts by
date/time/freq, and POSTs to http://wsprnet.org/meptspots.php.

On success: deletes processed files, appends to /var/log/wspr.log.
On failure: leaves files in queue and retries after RETRY_SECS.

Polls the queue directory every WD_POLL_INTERVAL seconds (default 10).
Uploads immediately after WD_STABLE_POLLS consecutive polls with no new files
(default 2), so upload fires ~20 seconds after the last spot file lands.
No coupling to the 2-minute WSPR cycle — returns to polling immediately after
each upload.

Environment variables:
    WD_UPLOAD_WSPRNET_DIR   Queue directory to watch (e.g. .../wsprnet/AC0G=B1_EM38ww)
    WD_RECEIVER_CALL        Reporter callsign (e.g. AC0G/B1)
    WD_RECEIVER_GRID        Reporter grid (e.g. EM38ww)
    WD_VERSION              Version string embedded in upload (default: 4.0)
    WD_POLL_INTERVAL        Seconds between queue polls (default: 10)
    WD_STABLE_POLLS         Consecutive equal-count polls before upload (default: 1)
"""

import os
import sys
import time
import re
import logging
import urllib.request
import urllib.error
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path

_HERE = Path(__file__).resolve().parent
for _p in ['/opt/wsprdaemon/lib', str(_HERE.parent / 'lib')]:
    if Path(_p).exists() and _p not in sys.path:
        sys.path.insert(0, _p)

log = logging.getLogger('wd-upload-wsprnet')

UPLOAD_DIR     = Path(os.environ['WD_UPLOAD_WSPRNET_DIR'])
REPORTER_CALL  = os.environ['WD_RECEIVER_CALL']   # e.g. AC0G/B1
REPORTER_GRID  = os.environ['WD_RECEIVER_GRID']   # e.g. EM38ww
VERSION        = os.environ.get('WD_VERSION', '4.0')

WSPRNET_URL    = 'http://wsprnet.org/meptspots.php'
WSPR_LOG       = Path('/var/log/wspr.log')
WSPR_LOG_MAX   = 1_000_000   # 1 MB cap; truncate to 75% when exceeded
MAX_SPOTS      = 999     # wsprnet limit per upload transaction
POLL_INTERVAL  = int(os.environ.get('WD_POLL_INTERVAL', '10'))   # seconds between queue polls
STABLE_POLLS   = int(os.environ.get('WD_STABLE_POLLS', '1'))     # consecutive equal-count polls before upload
RETRY_SECS     = 60      # pause after a network/server error before retrying
UPLOAD_TIMEOUT = 300     # seconds before giving up on a POST
ARCHIVE_DIR    = Path(os.environ.get('WD_UPLOAD_ARCHIVE_DIR',
                       '/var/log/wsprdaemon/wsprnet-uploads'))
ARCHIVE_KEEP   = int(os.environ.get('WD_UPLOAD_ARCHIVE_KEEP', '96'))  # ~3.2 hours of cycles
PARTIAL_DIR    = Path('/var/log/wsprdaemon/wsprnet-partial')
PARTIAL_KEEP   = 10   # keep the 10 most recent partial-acceptance dumps
DIAGNOSTIC_UPLOAD = os.environ.get('WD_DIAGNOSTIC_UPLOAD', '0') == '1'

DEDUP_REJECTED_FILE = PARTIAL_DIR / 'dedup_rejected.txt'
DEDUP_REJECTED_MAX  = 500_000   # 500 KB rolling cap
DEDUP_FREQ_KHZ      = 1.0       # near-duplicate frequency window (kHz)


# ---------------------------------------------------------------------------
# HTTP multipart POST (stdlib only — no requests/curl dependency)
# ---------------------------------------------------------------------------

def _mept_post(spots_bytes: bytes) -> str:
    """POST spots file to wsprnet.org/meptspots.php, return response body."""
    boundary = b'--------WD4MeptBoundary'
    crlf = b'\r\n'

    def field(name: str, value: str) -> bytes:
        return (
            b'--' + boundary + crlf
            + b'Content-Disposition: form-data; name="' + name.encode() + b'"' + crlf
            + crlf
            + value.encode() + crlf
        )

    body = (
        field('version', f'WD_{VERSION}')
        + field('call', REPORTER_CALL)
        + field('grid', REPORTER_GRID)
        + b'--' + boundary + crlf
        + b'Content-Disposition: form-data; name="allmept"; filename="spots.txt"' + crlf
        + b'Content-Type: text/plain' + crlf
        + crlf
        + spots_bytes + crlf
        + b'--' + boundary + b'--' + crlf
    )

    req = urllib.request.Request(
        WSPRNET_URL,
        data=body,
        headers={'Content-Type': 'multipart/form-data; boundary=' + boundary.decode()},
        method='POST',
    )
    with urllib.request.urlopen(req, timeout=UPLOAD_TIMEOUT) as resp:
        return resp.read().decode(errors='replace')


# ---------------------------------------------------------------------------
# Spot file handling
# ---------------------------------------------------------------------------

def collect_files() -> list:
    """Return spot files in queue sorted oldest-first."""
    return sorted(UPLOAD_DIR.glob('*_spots.txt'), key=lambda p: p.stat().st_mtime)


def _valid_spot(line: str) -> bool:
    """Return True if line looks like a valid MEPT spot (YYMMDD HHMM ...)."""
    p = line.split()
    # Minimum 8 fields; first field must be a 6-digit date, second a 4-digit time
    return (len(p) >= 8
            and len(p[0]) == 6 and p[0].isdigit()
            and len(p[1]) == 4 and p[1].isdigit())


def _has_hash_callsign(line: str) -> bool:
    """Return True if the callsign field (column 7) is an unresolved hash.

    When jt9 cannot resolve a hash to a real callsign it outputs the raw hash
    value in angle brackets, e.g. '<A1B2C>'.  These spots are meaningless to
    wsprnet (no real callsign) and are rejected server-side, so we drop them
    before uploading.
    """
    p = line.split()
    if len(p) < 7:
        return False
    call = p[6]
    return call.startswith('<') and call.endswith('>')


def read_batch(files: list) -> tuple:
    """Read up to MAX_SPOTS valid lines from files.
    Returns (lines, included_files, file_lines, hash_filtered) where
    file_lines maps each included file to its list of spot lines and
    hash_filtered is the total count of unresolved-hash spots dropped.
    """
    lines = []
    included = []
    file_lines: dict = {}
    hash_filtered = 0
    for f in files:
        try:
            raw = [l for l in f.read_text().splitlines()
                   if l.strip() and _valid_spot(l)]
        except OSError as e:
            log.warning('cannot read %s: %s', f.name, e)
            continue
        # Split into uploadable spots and unresolved-hash spots
        new = []
        for l in raw:
            if _has_hash_callsign(l):
                hash_filtered += 1
            else:
                new.append(l)
        if not new:
            # File is empty or contains only malformed/hash lines — discard it
            f.unlink(missing_ok=True)
            continue
        if len(lines) + len(new) > MAX_SPOTS:
            break
        lines.extend(new)
        included.append(f)
        file_lines[f] = new
    return lines, included, file_lines, hash_filtered


def sort_spots(lines: list) -> list:
    """Sort spots by date (col 1), time (col 2), frequency (col 6).
    11-field wsprnet MEPT format: date time sync snr dt freq call grid power drift ntype
    """
    def key(line):
        p = line.split()
        try:
            return (p[0], p[1], float(p[5]))
        except (IndexError, ValueError):
            return ('', '', 0.0)
    return sorted(lines, key=key)


def parse_response(response: str) -> tuple:
    """Return (offered, added) from wsprnet response, or (None, None).

    Handles known response formats:
      "973 out of 995 spot(s) added"
      "1 spot(s) added to database of 4 spot(s) offered"
      "X spots added"
    """
    # "973 out of 995 spot(s) added"
    m = re.search(r'(\d+)\s+out\s+of\s+(\d+)\s+spot', response, re.I)
    if m:
        return int(m.group(2)), int(m.group(1))
    # "1 spot(s) added to database of 4 spot(s) offered"
    m = re.search(r'(\d+)\s+spot.*?added.*?(\d+)\s+spot.*?offered', response, re.I | re.S)
    if m:
        return int(m.group(2)), int(m.group(1))
    # "X spots added"
    m = re.search(r'(\d+)\s+spots?\s+added', response, re.I)
    if m:
        return None, int(m.group(1))
    return None, None


def archive_batch(spots_bytes: bytes, n_spots: int, n_files: int) -> None:
    """Save the spot payload to ARCHIVE_DIR for post-hoc inspection, then rotate."""
    try:
        ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)
        ts = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
        archive_file = ARCHIVE_DIR / f'{ts}_{n_spots}spots_{n_files}files.txt'
        archive_file.write_bytes(spots_bytes)

        # Rotate: keep only the newest ARCHIVE_KEEP files
        archives = sorted(ARCHIVE_DIR.glob('*.txt'))
        for old in archives[:-ARCHIVE_KEEP]:
            old.unlink(missing_ok=True)
    except OSError as e:
        log.warning('archive failed: %s', e)


# Valid WSPR power levels in dBm
_VALID_POWERS = {0, 3, 7, 10, 13, 17, 20, 23, 27, 30, 33, 37, 40, 43, 47, 50, 53, 57, 60}
# Maidenhead grid: two letters (A-R) + two digits [+ two letters (A-X)]
_GRID_RE = re.compile(r'^[A-Ra-r]{2}\d{2}([A-Xa-x]{2})?$')


def _analyze_spots(spot_lines: list) -> str:
    """Examine spot lines and flag anything that might cause server-side rejection.

    Checks each spot for:
      - Malformed Maidenhead grid (type 1 spots only — callsign has no '/')
      - Non-standard WSPR power level (type 1 spots only)
      - Duplicate (date, time, freq, call) within this batch

    Type 2/3 spots (callsign contains '/') use different field encodings for
    grid and power, so those checks are skipped for them.  SNR is not checked
    because valid WSPR SNR spans roughly -52 to +50 dB.

    Returns a multi-line string; empty string if nothing suspicious.
    """
    flags = []
    seen: dict = {}   # (date, time, freq, call) → first line index

    for i, line in enumerate(spot_lines):
        p = line.split()
        if len(p) < 9:
            flags.append(f'  [{i+1}] too few fields: {line.rstrip()}')
            continue

        issues = []
        call = p[6]
        type1 = '/' not in call   # type 2/3 extended spots have '/' in callsign

        if type1:
            # Grid — field 8 (index 7): must be 4 or 6-char Maidenhead
            grid = p[7]
            if not _GRID_RE.match(grid):
                issues.append(f'grid={grid!r} malformed')

            # Power — field 9 (index 8): must be a standard WSPR power level
            try:
                pwr = int(p[8])
                if pwr not in _VALID_POWERS:
                    issues.append(f'power={pwr} not a standard WSPR level')
            except ValueError:
                issues.append(f'non-integer power={p[8]!r}')

        # Duplicate spot within batch: (date, time, freq, call) — applies to all types
        key = (p[0], p[1], p[5], call)
        if key in seen:
            issues.append(f'duplicate of line {seen[key]+1}')
        else:
            seen[key] = i

        if issues:
            flags.append(f'  [{i+1}] {", ".join(issues)}\n      {line.rstrip()}')

    if not flags:
        return 'no suspicious spots found\n'
    return f'{len(flags)} potentially suspicious spot(s):\n' + '\n'.join(flags) + '\n'


def save_upload_dump(spots_bytes: bytes, cyc_date: str, cyc_time: str,
                     offered: int, added: int, response: str,
                     spot_lines: list) -> None:
    """Save every upload — spots + server response + spot analysis — to PARTIAL_DIR.

    Filename encodes offered/accepted counts; when all are accepted the numbers
    are equal and the file is still written so you can compare against partial
    uploads side-by-side.

    File sections:
        --- SPOTS OFFERED ---       one spot per line
        --- WSPRNET RESPONSE ---    full verbatim server reply
        --- SPOT ANALYSIS ---       automated checks on the spot lines

    Keeps only the PARTIAL_KEEP most recent files.
    Partial uploads (accepted < offered) are logged at WARNING so they appear
    in wdwatch; full-acceptance dumps are logged at DEBUG (quiet).
    """
    try:
        PARTIAL_DIR.mkdir(parents=True, exist_ok=True)
        ts = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
        fname = PARTIAL_DIR / (
            f'{ts}_cycle{cyc_date}{cyc_time}'
            f'_offered{offered}_accepted{added}.txt'
        )

        analysis = _analyze_spots(spot_lines)
        content = (
            b'--- SPOTS OFFERED ---\n'
            + spots_bytes
            + b'\n--- WSPRNET RESPONSE ---\n'
            + response.encode(errors='replace')
            + b'\n--- SPOT ANALYSIS ---\n'
            + analysis.encode()
        )
        fname.write_bytes(content)

        partial = (added is not None and offered is not None and added < offered)
        if partial:
            log.warning('PARTIAL DUMP  cycle=%s %s  accepted=%s/%s  → %s',
                        cyc_date, cyc_time, added, offered, fname)
        else:
            log.debug('upload dump   cycle=%s %s  accepted=%s/%s  → %s',
                      cyc_date, cyc_time, added, offered, fname)

        # Rotate: keep only the PARTIAL_KEEP newest files
        existing = sorted(PARTIAL_DIR.glob('*.txt'))
        for old in existing[:-PARTIAL_KEEP]:
            old.unlink(missing_ok=True)
    except OSError as e:
        log.warning('upload dump failed: %s', e)


def diagnostic_upload(cyc_lines: list, cyc_date: str, cyc_time: str) -> None:
    """Upload each spot one at a time so we can identify which ones wsprnet rejects.

    When DIAGNOSTIC_UPLOAD=True this IS the primary upload (bulk POST is skipped).
    When triggered automatically after a partial bulk acceptance it is secondary
    (those spots are already uploaded; re-uploading individually lets us identify
    the bad ones, though wsprnet may also say '0 added' for duplicates).

    Logging:
      - DIAG REJECT logged immediately for each rejected spot
      - DIAG DONE logged once at the end with the summary
      - individual accepted spots are NOT logged

    Saves a timestamped report to PARTIAL_DIR.
    """
    log.info('DIAG START    cycle=%s %s  spots=%d',
             cyc_date, cyc_time, len(cyc_lines))

    accepted_lines = []
    rejected_lines = []
    error_lines    = []

    for line in cyc_lines:
        spot_bytes = (line + '\n').encode()
        try:
            resp = _mept_post(spot_bytes)
        except (urllib.error.URLError, OSError) as e:
            error_lines.append((line, f'network error: {e}'))
            continue

        offered, added = parse_response(resp)
        if added == 1:
            accepted_lines.append(line)
        else:
            rejected_lines.append((line, resp.strip()))
            log.warning('DIAG REJECT   cycle=%s %s  server=%s  spot: %s',
                        cyc_date, cyc_time, resp.strip()[:120], line.rstrip())

    n_ok  = len(accepted_lines)
    n_bad = len(rejected_lines)
    n_err = len(error_lines)
    n_tot = len(cyc_lines)

    if n_bad or n_err:
        log.warning('DIAG DONE     cycle=%s %s  accepted=%d/%d  rejected=%d  errors=%d',
                    cyc_date, cyc_time, n_ok, n_tot, n_bad, n_err)
    else:
        log.info('DIAG DONE     cycle=%s %s  accepted=%d/%d',
                 cyc_date, cyc_time, n_ok, n_tot)

    # Save report to PARTIAL_DIR
    try:
        PARTIAL_DIR.mkdir(parents=True, exist_ok=True)
        ts = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
        fname = PARTIAL_DIR / (
            f'{ts}_cycle{cyc_date}{cyc_time}'
            f'_diag_accepted{n_ok}_rejected{n_bad}.txt'
        )
        parts = [f'--- DIAGNOSTIC UPLOAD cycle={cyc_date} {cyc_time} ---\n',
                 f'tested:   {n_tot}\n',
                 f'accepted: {n_ok}\n',
                 f'rejected: {n_bad}\n',
                 f'errors:   {n_err}\n']
        if rejected_lines:
            parts.append('\n--- REJECTED SPOTS ---\n')
            for spot, resp in rejected_lines:
                parts.append(f'{spot.rstrip()}\n  server: {resp[:200]}\n')
        if error_lines:
            parts.append('\n--- NETWORK ERRORS ---\n')
            for spot, err in error_lines:
                parts.append(f'{spot.rstrip()}\n  error: {err}\n')
        if accepted_lines:
            parts.append('\n--- ACCEPTED SPOTS ---\n')
            parts.extend(l + '\n' for l in accepted_lines)
        fname.write_text(''.join(parts))
        if n_bad or n_err:
            log.warning('DIAG REPORT   → %s', fname)

        existing = sorted(PARTIAL_DIR.glob('*.txt'))
        for old in existing[:-PARTIAL_KEEP]:
            old.unlink(missing_ok=True)
    except OSError as e:
        log.warning('diag report write failed: %s', e)


def _dedup_spots(lines: list) -> tuple:
    """Remove near-duplicate spots before upload.

    A near-duplicate is defined as two spots sharing the same callsign
    and WSPR cycle (date + time) whose frequencies are within
    DEDUP_FREQ_KHZ of each other.  When duplicates are found the spot
    with the best (highest / least-negative) SNR is kept; the rest are
    dropped.

    Uses union-find so that chains of overlapping near-duplicates are
    collapsed into a single cluster correctly.

    Returns:
        (kept_lines, dropped_pairs) where dropped_pairs is a list of
        (dropped_line, kept_line) 2-tuples.
    """
    FREQ_TOL_MHZ = DEDUP_FREQ_KHZ / 1000.0

    # Parse spots into structured form
    parsed = []
    for line in lines:
        p = line.split()
        if len(p) < 8:
            parsed.append({'line': line, 'date': '', 'time': '',
                           'snr': -99, 'freq_mhz': 0.0, 'call': ''})
            continue
        try:
            freq_mhz = float(p[5])
        except ValueError:
            freq_mhz = 0.0
        try:
            snr = int(p[3])
        except ValueError:
            snr = -99
        parsed.append({
            'line': line,
            'date': p[0],
            'time': p[1],
            'snr': snr,
            'freq_mhz': freq_mhz,
            'call': p[6],
        })

    # Group indices by (date, time, callsign)
    groups: dict = defaultdict(list)
    for i, sp in enumerate(parsed):
        groups[(sp['date'], sp['time'], sp['call'])].append(i)

    keep_set: set = set()
    dropped_pairs: list = []

    for indices in groups.values():
        if len(indices) == 1:
            keep_set.add(indices[0])
            continue

        # Union-find over this group
        parent = {i: i for i in indices}

        def _find(x: int) -> int:
            while parent[x] != x:
                parent[x] = parent[parent[x]]
                x = parent[x]
            return x

        for a in range(len(indices)):
            for b in range(a + 1, len(indices)):
                ia, ib = indices[a], indices[b]
                if abs(parsed[ia]['freq_mhz'] - parsed[ib]['freq_mhz']) <= FREQ_TOL_MHZ:
                    ra, rb = _find(ia), _find(ib)
                    if ra != rb:
                        parent[ra] = rb

        # Collect clusters
        clusters: dict = defaultdict(list)
        for i in indices:
            clusters[_find(i)].append(i)

        for cluster in clusters.values():
            best = max(cluster, key=lambda i: parsed[i]['snr'])
            keep_set.add(best)
            for i in cluster:
                if i != best:
                    dropped_pairs.append((parsed[i]['line'], parsed[best]['line']))

    kept = [lines[i] for i in range(len(lines)) if i in keep_set]
    return kept, dropped_pairs


def _log_dedup_rejected(dropped_pairs: list, cyc_date: str, cyc_time: str) -> None:
    """Append dedup-dropped spots to the rolling rejected log in PARTIAL_DIR."""
    if not dropped_pairs:
        return
    try:
        PARTIAL_DIR.mkdir(parents=True, exist_ok=True)
        ts = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
        out = [f'\n# dedup  cycle={cyc_date} {cyc_time}  at={ts}  dropped={len(dropped_pairs)}\n']
        for dropped, kept in dropped_pairs:
            out.append(f'DROPPED  {dropped.rstrip()}\n')
            out.append(f'KEPT     {kept.rstrip()}\n')
        with DEDUP_REJECTED_FILE.open('a') as f:
            f.writelines(out)
        # Rolling cap
        size = DEDUP_REJECTED_FILE.stat().st_size
        if size > DEDUP_REJECTED_MAX:
            data = DEDUP_REJECTED_FILE.read_bytes()
            keep_from = len(data) - int(DEDUP_REJECTED_MAX * 0.75)
            nl = data.find(b'\n', keep_from)
            trimmed = data[nl + 1:] if nl != -1 else data[keep_from:]
            DEDUP_REJECTED_FILE.write_bytes(trimmed)
    except OSError as e:
        log.warning('dedup reject log failed: %s', e)


def append_wspr_log(lines: list) -> None:
    """Append uploaded spots to /var/log/wspr.log (KA9Q standard location).
    Caps the file at WSPR_LOG_MAX bytes by discarding the oldest 25% when exceeded.
    """
    try:
        WSPR_LOG.touch(exist_ok=True)
        with WSPR_LOG.open('a') as f:
            f.write('\n'.join(lines) + '\n')
        # Rotate if over cap: keep newest 75%
        size = WSPR_LOG.stat().st_size
        if size > WSPR_LOG_MAX:
            data = WSPR_LOG.read_bytes()
            keep_from = len(data) - int(WSPR_LOG_MAX * 0.75)
            # Advance to the next newline so we don't split a spot line
            nl = data.find(b'\n', keep_from)
            trimmed = data[nl + 1:] if nl != -1 else data[keep_from:]
            WSPR_LOG.write_bytes(trimmed)
            log.info('rotated %s: %.0f KB → %.0f KB',
                     WSPR_LOG, size / 1024, len(trimmed) / 1024)
    except OSError as e:
        log.warning('cannot write %s: %s', WSPR_LOG, e)


# ---------------------------------------------------------------------------
# Cycle timing helpers
# ---------------------------------------------------------------------------

def _cycle_end_epoch(cyc_date: str, cyc_time: str) -> float:
    """Return Unix timestamp when this 2-minute WSPR cycle ends.

    cyc_date = YYMMDD, cyc_time = HHMM (from spot line columns 1 & 2).
    Returns 0.0 for unparseable input so those files upload immediately.
    """
    try:
        dt = datetime(2000 + int(cyc_date[:2]),
                      int(cyc_date[2:4]),
                      int(cyc_date[4:6]),
                      int(cyc_time[:2]),
                      int(cyc_time[2:4]),
                      tzinfo=timezone.utc)
        return dt.timestamp() + 120  # WSPR cycle is 2 minutes long
    except (ValueError, IndexError):
        return 0.0


# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------

def main() -> int:
    logging.basicConfig(
        level=logging.INFO,
        format='%(asctime)sZ %(name)s %(levelname)s %(message)s',
        datefmt='%Y-%m-%dT%H:%M:%S',
    )
    log.info('starting: reporter %s %s  queue: %s  poll=%ds stable=%d',
             REPORTER_CALL, REPORTER_GRID, UPLOAD_DIR, POLL_INTERVAL, STABLE_POLLS)
    UPLOAD_DIR.mkdir(parents=True, exist_ok=True)

    prev_count   = 0
    stable_count = 0

    while True:
        time.sleep(POLL_INTERVAL)
        curr_count = len(collect_files())

        if curr_count == 0:
            prev_count   = 0
            stable_count = 0
            continue

        if curr_count != prev_count:
            # Queue changed — reset stability and keep polling
            log.debug('queue %d → %d files', prev_count, curr_count)
            prev_count   = curr_count
            stable_count = 0
            continue

        # Count is unchanged and > 0
        stable_count += 1
        if stable_count < STABLE_POLLS:
            continue

        # STABLE_POLLS consecutive equal polls → upload everything queued
        prev_count   = 0
        stable_count = 0

        files = collect_files()
        lines, included, file_lines, hash_filtered = read_batch(files)
        if not lines:
            continue

        def _file_cycle(f):
            fl = file_lines.get(f, [])
            p = fl[0].split() if fl else []
            return (p[0], p[1]) if len(p) >= 2 else ('', '')

        all_cycles = sorted(set(_file_cycle(f) for f in included))

        if len(all_cycles) > 1:
            log.info('MULTI CYCLE   queued %d cycles (%s) — uploading all',
                     len(all_cycles),
                     ', '.join(f'{d} {t}' for d, t in all_cycles))

        if hash_filtered:
            log.info('hash filtered  total=%d unresolved-hash spots dropped before upload',
                     hash_filtered)

        # Upload one cycle at a time, oldest first.
        # In diagnostic mode each spot is posted individually (no bulk POST).
        # In normal mode a single bulk MEPT POST is used; if it has partial
        # acceptance a secondary diagnostic run fires to identify bad spots.
        # On network failure stop immediately and retry after RETRY_SECS.
        upload_failed = False
        for cyc_date, cyc_time in all_cycles:
            cyc_files = [f for f in included if _file_cycle(f) == (cyc_date, cyc_time)]
            cyc_lines_raw = [l for f in cyc_files for l in file_lines[f]]
            cyc_lines_raw, dedup_dropped = _dedup_spots(cyc_lines_raw)
            if dedup_dropped:
                log.info('dedup          cycle=%s %s  dropped=%d near-duplicate spot(s)',
                         cyc_date, cyc_time, len(dedup_dropped))
                _log_dedup_rejected(dedup_dropped, cyc_date, cyc_time)
            cyc_lines = sort_spots(cyc_lines_raw)
            spots_bytes = ('\n'.join(cyc_lines) + '\n').encode()

            log.info('UPLOAD START  cycle=%s %s  spots=%d  files=%d',
                     cyc_date, cyc_time, len(cyc_lines), len(cyc_files))

            if DIAGNOSTIC_UPLOAD:
                # Diagnostic mode: one MEPT POST per spot — this IS the upload.
                diagnostic_upload(cyc_lines, cyc_date, cyc_time)
            else:
                # Normal mode: bulk MEPT POST.
                archive_batch(spots_bytes, len(cyc_lines), len(cyc_files))
                try:
                    response = _mept_post(spots_bytes)
                except (urllib.error.URLError, OSError) as e:
                    log.warning('UPLOAD FAILED  cycle=%s %s  error=%s  retry in %ds',
                                cyc_date, cyc_time, e, RETRY_SECS)
                    upload_failed = True
                    break

                run_diagnostic = False
                if re.search(r'[Uu]pload limit.*reached', response):
                    log.warning('UPLOAD REJECTED  cycle=%s %s  reason=upload-limit  flushing %d files',
                                cyc_date, cyc_time, len(cyc_files))
                    save_upload_dump(spots_bytes, cyc_date, cyc_time,
                                     len(cyc_lines), 0, response, cyc_lines)
                    run_diagnostic = True
                else:
                    offered, added = parse_response(response)
                    if offered is None and added is None:
                        log.warning('UPLOAD DONE   cycle=%s %s  unparseable response (flushing):\n%s',
                                    cyc_date, cyc_time, response[-300:])
                        save_upload_dump(spots_bytes, cyc_date, cyc_time,
                                         len(cyc_lines), 0, response, cyc_lines)
                        run_diagnostic = True
                    elif added == 0:
                        log.warning('UPLOAD DONE   cycle=%s %s  accepted=0/%s',
                                    cyc_date, cyc_time, offered)
                        save_upload_dump(spots_bytes, cyc_date, cyc_time,
                                         offered, 0, response, cyc_lines)
                        run_diagnostic = True
                    else:
                        log.info('UPLOAD DONE   cycle=%s %s  accepted=%s/%s',
                                 cyc_date, cyc_time, added, offered)
                        save_upload_dump(spots_bytes, cyc_date, cyc_time,
                                         offered, added, response, cyc_lines)
                        if offered is not None and added < offered:
                            run_diagnostic = True

                if run_diagnostic:
                    diagnostic_upload(cyc_lines, cyc_date, cyc_time)

            append_wspr_log(cyc_lines)
            for f in cyc_files:
                f.unlink(missing_ok=True)

        if upload_failed:
            time.sleep(RETRY_SECS)


if __name__ == '__main__':
    sys.exit(main())
