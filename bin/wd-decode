#!/bin/bash
# /usr/local/sbin/wd-decode
# Decoder daemon — watches recording directory for wav files,
# concatenates with sox, runs wsprd (W-modes) or jt9 (F-modes).
#
# For KA9Q sources: uses inotifywait (clean open/close on wav files).
# For Kiwi sources: uses polling (kiwi_recorder opens/closes continuously).

set -euo pipefail

# Contract §11 log-level resolution + SIGHUP handler.
for _d in /opt/wsprdaemon-client/lib /usr/local/share/wsprdaemon/lib; do
    if [[ -r "${_d}/wd-loglevel.sh" ]]; then
        # shellcheck source=/dev/null
        . "${_d}/wd-loglevel.sh"
        break
    fi
done

# Resolve decoder binaries from the project's decoders directory.
# Never rely on PATH — these are versioned project binaries.
_DECODER_DIR="/opt/wsprdaemon-client/bin/decoders"
_ARCH=$(uname -m)
case "${_ARCH}" in
    x86_64)       WSPRD_BIN="${_DECODER_DIR}/wsprd-x86-v27"
                  JT9_BIN="${_DECODER_DIR}/jt9-x86-v27" ;;
    aarch64)      WSPRD_BIN="${_DECODER_DIR}/wsprd-arm64-v27"
                  JT9_BIN="${_DECODER_DIR}/jt9-arm64-v27" ;;
    armv7l|armhf) WSPRD_BIN="${_DECODER_DIR}/wsprd-armhf-v26"
                  JT9_BIN="${_DECODER_DIR}/jt9-arm32-v26" ;;
    *)  echo "wd-decode: unsupported architecture ${_ARCH}" >&2; exit 1 ;;
esac

if [[ ! -x "${WSPRD_BIN}" ]]; then
    echo "wd-decode: wsprd binary not found: ${WSPRD_BIN}" >&2
    exit 1
fi

: "${WD_RECEIVER_NAME:?}"
: "${WD_RECEIVER_TYPE:?}"
: "${WD_RECEIVER_BAND:?}"
: "${WD_RECEIVER_MODES:?}"
: "${WD_RECEIVER_FREQ_HZ:?}"
: "${WD_RECORDING_DIR:?}"
: "${WD_POSTING_DIR:?}"
: "${WD_RUN_DIR:?}"

# Optional — present in all current env files; default gracefully if absent.
WD_RECEIVER_CALL="${WD_RECEIVER_CALL:-UNKNOWN}"
WD_RECEIVER_GRID="${WD_RECEIVER_GRID:-AA00}"

# Extended-spot tooling
_C2_NOISE_PY="/opt/wsprdaemon-client/bin/c2_noise.py"
_WD_EXTEND_SPOTS="/usr/local/sbin/wd-extend-spots"
# Pre-TX / post-TX time windows used to sample background noise from the wav.
# Units: seconds from wav start.  WSPR-2 wav = 120 s total.
#   Pre-TX  : 0.25 – 0.75 s  (before beacon starts at ~1 s)
#   TX      : 1    – 110 s   (the beacon transmission window)
#   Post-TX : 113  – 118 s   (after beacon ends)
_NOISE_PRE_START=0.25;  _NOISE_PRE_LEN=0.5
_NOISE_TX_START=1;      _NOISE_TX_LEN=109
_NOISE_POST_START=113;  _NOISE_POST_LEN=5

# Calibration constants (from v3 decoding.sh defaults — see calculate_nl_adjustments()).
# These convert sox dBFS and c2_noise.py arbitrary-power values to dBm.
#
# RMS: rms_nl_adjust = cal_rms_offset + 10*log10(1/cal_ne_bw)
#                    = -50.4 + 10*log10(1/246) = -50.4 - 23.91 = -74.31 dB
#
# FFT: fft_nl_adjust = cal_c2_correction = -187.7 dB
#
# The KiwiSDR frequency-dependent amplitude correction and per-antenna factor
# from v3 are not applied here — ka9q radiod already delivers calibrated levels.
_RMS_NL_ADJUST=-74.31
_FFT_NL_ADJUST=-187.7

# Extract 4 dB stats (Pk, RMS, RMSpk, RMStr) from one time window of a wav.
_wav_window_stats() {
    local wav=$1 start=$2 len=$3
    sox "${wav}" -t wav - trim "${start}" "${len}" 2>/dev/null \
        | sox - -n stats 2>&1 \
        | awk '/dB/{printf "%s ", $NF}'
    echo
}

# Compute the 15-field noise line for a decoded wav+c2 pair.
# Outputs nothing (and returns 1) on failure.
_compute_noise_line() {
    local wav=$1 c2=$2
    local pre tx post
    pre=$(_wav_window_stats "${wav}" "${_NOISE_PRE_START}"  "${_NOISE_PRE_LEN}")
    tx=$( _wav_window_stats "${wav}" "${_NOISE_TX_START}"   "${_NOISE_TX_LEN}")
    post=$(_wav_window_stats "${wav}" "${_NOISE_POST_START}" "${_NOISE_POST_LEN}")

    local pre_list=( ${pre} )
    local tx_list=(  ${tx}  )
    local post_list=( ${post} )

    if (( ${#pre_list[@]} != 4 || ${#tx_list[@]} != 4 || ${#post_list[@]} != 4 )); then
        echo "wd-decode noise: unexpected sox field count pre=${#pre_list[@]} tx=${#tx_list[@]} post=${#post_list[@]}" >&2
        return 1
    fi

    # rms_noise = min(pre RMS Tr dB [field 4], post RMS Tr dB [field 4]),
    # then calibrated to dBm by adding _RMS_NL_ADJUST.
    local pre_rms="${pre_list[3]}"
    local post_rms="${post_list[3]}"
    local rms_raw
    if (( $(echo "${pre_rms} < ${post_rms}" | bc -l) )); then
        rms_raw="${pre_rms}"
    else
        rms_raw="${post_rms}"
    fi
    local rms_noise
    rms_noise=$(awk "BEGIN { printf \"%.2f\", ${rms_raw} + ${_RMS_NL_ADJUST} }")

    local fft_noise="0.00"
    if [[ -f "${c2}" && -x "${_C2_NOISE_PY}" ]]; then
        local fft_raw
        fft_raw=$(python3 "${_C2_NOISE_PY}" "${c2}" 2>/dev/null | tr -d ' ') || fft_raw=""
        if [[ -n "${fft_raw}" ]]; then
            fft_noise=$(awk "BEGIN { printf \"%.2f\", ${fft_raw} + ${_FFT_NL_ADJUST} }")
        fi
    fi

    echo "${pre} ${tx} ${post} ${rms_noise} ${fft_noise} 0"
}

mkdir -p "${WD_RECORDING_DIR}"
mkdir -p "${WD_POSTING_DIR}"

# Prevent two instances of this decoder from running concurrently for the same
# receiver+band.  A second instance (e.g. from an accidental manual start)
# races on ALL_WSPR.TXT, doubles every spot file, and floods the uploader.
_LOCK_FILE="${WD_RECORDING_DIR}/.wd-decode.lock"
exec 9>"${_LOCK_FILE}"
if ! flock -n 9; then
    echo "wd-decode: another instance is already running for ${WD_RECEIVER_NAME}/${WD_RECEIVER_BAND} — exiting" >&2
    exit 1
fi

readonly MAX_ALL_WSPR_SIZE=200000   # ~200KB — truncate when exceeded (v3 uses same limit)

# Track last-decoded wav file per mode to prevent re-decoding the same file
# when inotifywait fires for a different period's wav (e.g. _300.wav triggering
# a re-run of W2 on the unchanged _120.wav).
declare -A _last_decoded_wav

# Parse mode list (colon-separated: W2:F2:F5)
IFS=':' read -ra MODES <<< "${WD_RECEIVER_MODES}"

echo "wd-decode: ${WD_RECEIVER_NAME} band ${WD_RECEIVER_BAND}"
echo "  modes: ${WD_RECEIVER_MODES}"
echo "  recording dir: ${WD_RECORDING_DIR}"
echo "  posting dir: ${WD_POSTING_DIR}"

# Determine file watching method based on receiver type
use_inotify=false
if [[ "${WD_RECEIVER_TYPE}" == "ka9q" || "${WD_RECEIVER_TYPE}" == "ka9q_wwv" ]]; then
    use_inotify=true
fi

# Sidecar gate: if a wspr-recorder JSON sidecar exists next to the WAV,
# honor its authoritative decode_modes / period_seconds. Return 0 if the
# WAV should be decoded for this mode, 1 if the sidecar explicitly excludes
# it. Absent or unparseable sidecars are treated as "no opinion" (return 0)
# so the Kiwi path (which emits no sidecar) still works unchanged.
sidecar_permits_mode() {
    local wav_file="$1"
    local mode="$2"
    local window="${mode:1}"
    local expected_period=$(( window * 60 ))
    local sidecar="${wav_file%.wav}.json"
    [[ -r "${sidecar}" ]] || return 0
    python3 - "${sidecar}" "${mode}" "${expected_period}" <<'PY' || return 1
import json, sys
path, mode, expected_period = sys.argv[1], sys.argv[2], int(sys.argv[3])
try:
    with open(path) as f:
        meta = json.load(f)
except Exception:
    sys.exit(0)
modes = meta.get("decode_modes")
if isinstance(modes, list) and mode not in modes:
    sys.exit(1)
period = meta.get("period_seconds")
if isinstance(period, int) and period != expected_period:
    sys.exit(1)
sys.exit(0)
PY
}

decode_window() {
    # $1 = mode string (e.g., W2, F2, F5)
    local mode="$1"
    local prefix="${mode:0:1}"
    local window="${mode:1}"
    local freq_hz="${WD_RECEIVER_FREQ_HZ}"
    local period_sec=$(( window * 60 ))

    # wspr-recorder (v4+) writes period-length WAV files named:
    #   YYYYMMDDTHHMMSSz_freq_usb_${period_sec}.wav
    # Find the most recent one for this period length.
    local wav_file
    wav_file=$(find "${WD_RECORDING_DIR}" -maxdepth 1 -name "*_usb_${period_sec}.wav" \
               -printf '%T@\t%p\n' 2>/dev/null | sort -rn | head -1 | cut -f2)

    if [[ -z "${wav_file}" ]]; then
        return 0  # No period-length WAV ready yet
    fi

    if [[ "${wav_file}" == "${_last_decoded_wav[$mode]:-}" ]]; then
        return 0  # Already decoded this file for this mode; skip duplicate trigger
    fi

    if ! sidecar_permits_mode "${wav_file}" "${mode}"; then
        return 0  # wspr-recorder sidecar says this mode is not for this WAV
    fi

    # Check that the file starts on the correct UTC minute boundary for this mode:
    #   W2, F2  → even minutes only       (minute % 2 == 0)
    #   F5      → multiples of 5          (minute % 5 == 0)
    #   F15     → multiples of 15         (minute % 15 == 0)
    #   F30     → multiples of 30         (minute % 30 == 0)
    # Filename: 20260408T014800Z_7038600_usb_120.wav → minute = 48
    local fn_base
    fn_base=$(basename "${wav_file}" "_${period_sec}.wav")
    local first_minute
    if [[ "${fn_base}" =~ ^20[0-9]{6}T[0-9]{2}([0-9]{2})[0-9]{2}Z ]]; then
        first_minute="${BASH_REMATCH[1]}"
    else
        first_minute=$(date -u +%M)
    fi
    if (( 10#${first_minute} % window != 0 )); then
        return 0  # Not on the correct cycle boundary for this mode
    fi

    # Derive a WSPR-format timestamp filename (YYMMDD_HHMM.wav) so wsprd
    # embeds the correct date/time in ALL_WSPR.TXT output lines.
    local wspr_ts
    if [[ "${fn_base}" =~ ^20([0-9]{6})T([0-9]{2})([0-9]{2})[0-9]{2}Z ]]; then
        wspr_ts="${BASH_REMATCH[1]}_${BASH_REMATCH[2]}${BASH_REMATCH[3]}"
    else
        wspr_ts=$(date -u +%y%m%d_%H%M)
    fi

    # Mark this wav as decoded for this mode before running the decoder.
    _last_decoded_wav[$mode]="${wav_file}"

    # Log start — period-length WAV file, no concatenation needed.
    echo "DECODE START band=${WD_RECEIVER_BAND} mode=${mode} cycle=${wspr_ts} files=1"
    echo "  wavs: $(basename "${wav_file}")"

    local t_decode_start
    t_decode_start=$(date +%s)

    # wspr-recorder already delivers a normalized (-1 dBFS peak) int16 WAV.
    # Just copy it to the WSPR timestamp filename so wsprd embeds the correct
    # date/time in ALL_WSPR.TXT. No sox normalization needed or wanted.
    local concat_wav="${WD_RECORDING_DIR}/${wspr_ts}.wav"
    cp "${wav_file}" "${concat_wav}"

    if [[ ! -s "${concat_wav}" ]]; then
        echo "wd-decode: cp failed for mode ${mode}"
        return 1
    fi

    # Run decoder based on prefix
    local spots_file="${WD_RECORDING_DIR}/spots.txt"
    local freq_mhz
    freq_mhz=$(echo "scale=6; ${freq_hz}/1000000" | bc)

    case "${prefix}" in
        W)
            # wsprd appends new spots to ALL_WSPR.TXT (not stdout).
            # We diff before/after to find the newly added lines.
            # ALL_WSPR.TXT is also the decoder's hash table — it must persist across cycles.
            local all_wspr="${WD_RECORDING_DIR}/ALL_WSPR.TXT"
            local all_wspr_save="${WD_RECORDING_DIR}/ALL_WSPR.TXT.save"

            # wsprnet ntype for WSPR: window minutes (2 or 15)
            local wn_type="${window}"

            # Ensure the file exists, then sort and save the pre-decode state
            touch "${all_wspr}"
            sort -k1,2 -k5,5n -k6,6 "${all_wspr}" > "${all_wspr_save}"
            cp -p "${all_wspr_save}" "${all_wspr}"

            # Run wsprd — appends new spots to ALL_WSPR.TXT; capture stdout for
            # diagnostic comparison.  Spot lines in stdout look like:
            #   "  -3  0.3  14.097107  KD9LVN EN61  33   0  0"
            # (no date/time prefix — those are added only in ALL_WSPR.TXT)
            # -c: write .c2 file (first-pass subtraction aid)
            # -C ${WSPRD_C:-500}: max decoder cycles/bit.  500 is the v3
            #   wsprdaemon default — chosen so a Raspberry Pi finishes a
            #   13-band cycle inside the 2-min budget.  wsprd's own default
            #   is 10000 (~20× deeper).  Faster x86 hosts can set
            #   WSPRD_C=10000 in /etc/sigmond/coordination.env to recover
            #   weaker signals at the cost of CPU.
            # -o ${WSPRD_O:-4}: OSD decoding depth (0..5; v3 default 4).
            # -d (when WSPRD_DEEP unset or =1): deeper second-pass search.
            local wsprd_stdout="${WD_RECORDING_DIR}/wsprd_stdout.txt"
            local wsprd_deep_flag="-d"
            [[ "${WSPRD_DEEP:-1}" == "0" ]] && wsprd_deep_flag=""
            # Run wsprd in a subshell with CWD = WD_RECORDING_DIR so that the
            # 000000_0001.c2 file it creates (-c flag) lands in the per-band
            # directory rather than /tmp (the service WorkingDirectory).
            # Multiple band instances would otherwise race on /tmp/000000_0001.c2.
            ( cd "${WD_RECORDING_DIR}" && \
              "${WSPRD_BIN}" -a "${WD_RECORDING_DIR}" -c \
                  -C "${WSPRD_C:-500}" -o "${WSPRD_O:-4}" ${wsprd_deep_flag} \
                  -f "${freq_mhz}" "${concat_wav}" \
                  > "${wsprd_stdout}" 2>&1 ) || true

            # Sort updated ALL_WSPR.TXT and diff to find new spots, then convert
            # to 11-field wsprnet MEPT format:
            #   date time sync snr dt freq call grid power drift ntype
            # ALL_WSPR.TXT fields (v2.2+ wsprd, 17 fields with grid, 16 without):
            #   $1=date $2=time $3=snr $4=dt $5=freq $6=call $7=grid $8=pwr $9=drift $10=sync ...
            #   (no-grid variant: $6=call $7=pwr $8=drift $9=sync — 16 fields)
            sort -k1,2 -k5,5n -k6,6 "${all_wspr}" > "${WD_RECORDING_DIR}/sort.tmp"
            mv "${WD_RECORDING_DIR}/sort.tmp" "${all_wspr}"
            # Extract only spots from the current WSPR cycle.
            # wsprd silently appends hash-resolved entries from previous cycles
            # to ALL_WSPR.TXT (old timestamps, no stdout output). Without this
            # filter those old-cycle spots create spurious spot files that the
            # uploader re-uploads as duplicates for already-processed cycles.
            local wspr_date="${wspr_ts:0:6}"
            local wspr_time="${wspr_ts:7:4}"
            local new_spots
            new_spots=$(comm --nocheck-order -13 "${all_wspr_save}" "${all_wspr}" \
                | sort -k1,2 -k5,5n -k6,6 \
                | grep -v '<\.\.\.>' \
                | awk -v d="${wspr_date}" -v t="${wspr_time}" '$1==d && $2==t')

            # Log hash-resolved spots (<CALLSIGN>) to a separate file for review
            local hash_log="${WD_LOG_DIR}/hash_spots.log"
            grep '<' <<< "${new_spots}" \
                | awk -v band="${WD_RECEIVER_BAND}" \
                    '{ print strftime("%Y-%m-%dT%H:%M:%SZ"), band, $0 }' \
                >> "${hash_log}" || true

            # wsprnet short format (11 fields) — used by wd-upload-wsprnet
            awk -v wn_type="${wn_type}" '
                    NF >= 17 { printf "%-6s %4s %5.2f %3d %5.2f %12.7f %-14s %-6s %2d %2d %4d\n",
                                   $1,$2,$10,$3,$4,$5,$6,$7,$8,$9,wn_type; next }
                    NF == 16 { printf "%-6s %4s %5.2f %3d %5.2f %12.7f %-14s %-6s %2d %2d %4d\n",
                                   $1,$2,$9,$3,$4,$5,$6,"      ",$7,$8,wn_type; next }
                ' <<< "${new_spots}" > "${spots_file}" || true

            # --- wsprdaemon extended format (34 fields) + noise file ---
            # Find the .c2 file written by wsprd -c (named after the wspr timestamp)
            local c2_file
            c2_file=$(find "${WD_RECORDING_DIR}" -maxdepth 1 -name "*.c2" \
                      -newer "${all_wspr_save}" 2>/dev/null | head -1)
            [[ -z "${c2_file}" ]] && \
                c2_file=$(find "${WD_RECORDING_DIR}" -maxdepth 1 -name "*.c2" \
                          2>/dev/null | head -1)

            local noise_line=""
            if [[ -f "${concat_wav}" ]]; then
                noise_line=$(_compute_noise_line "${concat_wav}" "${c2_file:-/dev/null}") || true
            fi

            if [[ -n "${new_spots}" && -x "${_WD_EXTEND_SPOTS}" ]]; then
                local noise_vals=( ${noise_line} )
                local rms_noise="${noise_vals[12]:-0.0}"
                local fft_noise="${noise_vals[13]:-0.0}"
                local overloads="${noise_vals[14]:-0}"
                local wd_spots_file="${WD_RECORDING_DIR}/wd_spots.txt"
                "${_WD_EXTEND_SPOTS}" "${rms_noise}" "${fft_noise}" "${overloads}" \
                    "${WD_RECEIVER_CALL}" "${WD_RECEIVER_GRID}" \
                    <<< "${new_spots}" > "${wd_spots_file}" 2>/dev/null || true
            fi

            # Diagnostic: verify stdout spot count matches ALL_WSPR.TXT extraction.
            # wsprd stdout spot lines start with optional whitespace then SNR (a signed integer).
            # Non-spot lines (blank, "<DecodeFinished>", timing) do not match this pattern.
            local stdout_count extracted_count
            stdout_count=$(grep -cE '^\s*[+-]?[0-9]' "${wsprd_stdout}" 2>/dev/null) || stdout_count=0
            if [[ -n "${new_spots}" ]]; then
                extracted_count=$(wc -l <<< "${new_spots}")
            else
                extracted_count=0
            fi
            if [[ "${stdout_count}" -ne "${extracted_count}" ]]; then
                echo "DIAG MISMATCH band=${WD_RECEIVER_BAND} mode=${mode} cycle=${wspr_ts} stdout=${stdout_count} extracted=${extracted_count}"
            else
                echo "DIAG MATCH    band=${WD_RECEIVER_BAND} mode=${mode} cycle=${wspr_ts} spots=${extracted_count}"
            fi
            rm -f "${wsprd_stdout}"

            # Truncate ALL_WSPR.TXT if it exceeds the size limit to prevent unbounded growth
            local all_wspr_size
            all_wspr_size=$(stat -c%s "${all_wspr}" 2>/dev/null || echo 0)
            if (( all_wspr_size > MAX_ALL_WSPR_SIZE )); then
                # tail -c cuts at a byte boundary, which may split the first surviving
                # line. Drop that partial line with tail -n +2 so ALL_WSPR.TXT always
                # contains only complete records (partial lines confuse the sort/diff).
                tail -c "${MAX_ALL_WSPR_SIZE}" "${all_wspr}" \
                    | tail -n +2 > "${WD_RECORDING_DIR}/trunc.tmp"
                mv "${WD_RECORDING_DIR}/trunc.tmp" "${all_wspr}"
            fi
            ;;
        F)
            # jt9 FST4W decoder.
            # -f 1500: audio center frequency offset in Hz (not RF MHz)
            # -F 100: +/- 100 Hz search tolerance
            # Presence of plotspec/decdata marker files in working dir instructs jt9
            # to write high-resolution spot data to fst4_decodes.dat.
            local period_sec=$(( window * 60 ))
            local spot_date="${wspr_ts:0:6}"   # YYMMDD
            local spot_time="${wspr_ts:7:4}"   # HHMM

            # wsprnet ntype for FST4W (v3 convention: window_minutes + 1 except 5→5, 15→15, 30→30)
            # Specifically: F2→3, F5→5, F15→15, F30→30
            local wn_type
            case "${window}" in
                2)  wn_type=3  ;;
                5)  wn_type=5  ;;
                15) wn_type=15 ;;
                30) wn_type=30 ;;
                *)  wn_type=3  ;;
            esac

            local fst4_dat="${WD_RECORDING_DIR}/fst4_decodes.dat"

            # Record the current line count so we can extract only lines jt9 appends.
            # Using a line count is unambiguous; grep-by-content would match the first
            # occurrence of an identical line (possible when the same spot recurs across
            # cycles) and silently drop spots between that match and the true tail.
            local last_line=0
            if [[ -s "${fst4_dat}" ]]; then
                last_line=$(wc -l < "${fst4_dat}")
            fi

            touch "${WD_RECORDING_DIR}/plotspec" "${WD_RECORDING_DIR}/decdata"
            "${JT9_BIN}" -a "${WD_RECORDING_DIR}" -t "${WD_RECORDING_DIR}" --fst4w \
                -p "${period_sec}" -f 1500 -F 100 "${concat_wav}" \
                > "${WD_RECORDING_DIR}/jt9_output.txt" 2>&1 || true

            # Extract new high-resolution spots from fst4_decodes.dat.
            # fst4_decodes.dat fields (from v3/Gwyn G3ZIL documentation):
            #   $1=HHMMSS $2=icand $3=itry $4=nsyncoh $5=iaptype $6=ijitter
            #   $7=npct $8=ntype $9=Keff(66) $10=nsync_qual(sync) $11=nharderrors
            #   $12=dmin $13=nhp $14=hd $15=sync_power $16=xsnr $17=xdt $18=fsig_hz
            #   $19=w50 $20=call $21=grid(or power if no grid) $22=power(if grid present)
            # Output: 11-field wsprnet MEPT format
            #   date time sync snr dt freq call grid power drift ntype
            if [[ -s "${fst4_dat}" ]]; then
                # Fix lines where the sync field overflows its column width (rare)
                sed 's/\*\*\*\*\*\*\*\*\*/999999.99/' "${fst4_dat}" > "${fst4_dat}.fixed"

                # Extract only lines appended by this decode run
                local new_spots="${WD_RECORDING_DIR}/fst4_new.tmp"
                tail -n +"$((last_line + 1))" "${fst4_dat}.fixed" > "${new_spots}" || true
                rm -f "${fst4_dat}.fixed"

                # Format to 11-field wsprnet MEPT, filtering hashed unknown calls
                grep -v '<\.\.\.>' "${new_spots}" 2>/dev/null \
                    | awk -v date="${spot_date}" -v time="${spot_time}" \
                          -v freq_hz="${WD_RECEIVER_FREQ_HZ}" \
                          -v wn_type="${wn_type}" '
                        NF == 22 {
                            rf_mhz = (freq_hz + $18) / 1000000
                            printf "%-6s %4s %5.1f %3.0f %5.2f %12.7f %-14s %-6s %2d  0 %4d\n",
                                date, time, $10, $16, $17, rf_mhz, $20, $21, $22, wn_type
                        }
                        NF == 21 {
                            # No grid locator: $20=call $21=power
                            rf_mhz = (freq_hz + $18) / 1000000
                            printf "%-6s %4s %5.1f %3.0f %5.2f %12.7f %-14s %-6s %2d  0 %4d\n",
                                date, time, $10, $16, $17, rf_mhz, $20, "      ", $21, wn_type
                        }
                    ' > "${spots_file}" || true
                rm -f "${new_spots}"

                # Truncate fst4_decodes.dat to ~100 KB to prevent unbounded growth
                local fst4_size
                fst4_size=$(stat -c%s "${fst4_dat}" 2>/dev/null || echo 0)
                if (( fst4_size > 100000 )); then
                    tail -c 100000 "${fst4_dat}" > "${fst4_dat}.tmp"
                    mv "${fst4_dat}.tmp" "${fst4_dat}"
                fi
            fi
            ;;
        I)
            # IQ recording — no decode, just archive
            return 0
            ;;
        *)
            echo "wd-decode: unknown mode prefix: ${prefix}"
            return 1
            ;;
    esac

    # Remove the concatenated wav — it has served its purpose and should not
    # be mistaken for an original KA9Q recording on the next decode cycle.
    rm -f "${concat_wav}"

    # Move spots to posting directory; log result either way with elapsed time.
    local elapsed=$(( $(date +%s) - t_decode_start ))
    if [[ -s "${spots_file}" ]]; then
        local spot_count
        spot_count=$(wc -l < "${spots_file}")
        local timestamp
        timestamp=$(date -u +%Y%m%d_%H%M%S)
        local dest="${WD_POSTING_DIR}/${WD_RECEIVER_NAME}_${WD_RECEIVER_BAND}_${mode}_${timestamp}_spots.txt"
        mv "${spots_file}" "${dest}"
        echo "DECODE DONE  band=${WD_RECEIVER_BAND} mode=${mode} cycle=${wspr_ts} spots=${spot_count} elapsed=${elapsed}s"

        # Move extended wsprdaemon spot file if produced
        local wd_spots_file="${WD_RECORDING_DIR}/wd_spots.txt"
        if [[ -s "${wd_spots_file}" ]]; then
            local wd_dest="${WD_POSTING_DIR}/${WD_RECEIVER_NAME}_${WD_RECEIVER_BAND}_${mode}_${timestamp}_wd_spots.txt"
            mv "${wd_spots_file}" "${wd_dest}"
        fi

        # Write noise file if noise line was computed (only for W modes)
        if [[ "${prefix}" == "W" && -n "${noise_line:-}" ]]; then
            local noise_dest="${WD_POSTING_DIR}/${WD_RECEIVER_NAME}_${WD_RECEIVER_BAND}_${mode}_${timestamp}_noise.txt"
            echo "${noise_line}" > "${noise_dest}"
        fi
    else
        echo "DECODE DONE  band=${WD_RECEIVER_BAND} mode=${mode} cycle=${wspr_ts} spots=0 elapsed=${elapsed}s"
    fi
}

cleanup_old_wavs() {
    # Each mode produces one period-length WAV per cycle.  Keep the 2 most recent
    # per period type (current + one fallback); delete anything older.
    for mode in "${MODES[@]}"; do
        local window="${mode:1}"
        local period_sec=$(( window * 60 ))
        find "${WD_RECORDING_DIR}" -maxdepth 1 -name "*_${period_sec}.wav" \
             -printf '%T@\t%p\n' 2>/dev/null | sort -rn | tail -n +3 | cut -f2 | xargs -r rm -f
        find "${WD_RECORDING_DIR}" -maxdepth 1 -name "*_${period_sec}.json" \
             -printf '%T@\t%p\n' 2>/dev/null | sort -rn | tail -n +3 | cut -f2 | xargs -r rm -f
    done
}

run_decode_cycle() {
    for mode in "${MODES[@]}"; do
        decode_window "${mode}" || true
    done
    cleanup_old_wavs
}

# Main loop
if ${use_inotify}; then
    if ! command -v inotifywait >/dev/null 2>&1; then
        echo "wd-decode: inotifywait not found — required for ${WD_RECEIVER_TYPE} sources" >&2
        echo "wd-decode: install with: sudo apt install -y inotify-tools" >&2
        exit 1
    fi
    echo "wd-decode: using inotifywait for ${WD_RECEIVER_TYPE} source"
    while true; do
        # ka9q-radio writes .wav.tmp then renames → MOVED_TO .wav.
        # Trigger only on the rename so we fire exactly once per wav file.
        # Watching json close_write would double-trigger every cycle (wav rename
        # fires first, then the json sidecar close_write fires a second time),
        # causing alternate cycles to produce near-zero spots.
        inotifywait -q -e moved_to -t 120 "${WD_RECORDING_DIR}" \
            --include '\.wav$' >/dev/null 2>&1 || true
        run_decode_cycle
    done
else
    echo "wd-decode: using polling for ${WD_RECEIVER_TYPE} source"
    while true; do
        sleep 60  # Poll every minute (matches kiwi_recorder 1-min wav cycle)
        run_decode_cycle
    done
fi
