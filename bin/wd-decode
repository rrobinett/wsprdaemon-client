#!/bin/bash
# /usr/local/sbin/wd-decode
# Decoder daemon — watches recording directory for wav files,
# concatenates with sox, runs wsprd (W-modes) or jt9 (F-modes).
#
# For KA9Q sources: uses inotifywait (clean open/close on wav files).
# For Kiwi sources: uses polling (kiwi_recorder opens/closes continuously).

set -euo pipefail

# Resolve decoder binaries from the project's decoders directory.
# Never rely on PATH — these are versioned project binaries.
_DECODER_DIR="/opt/wsprdaemon/bin/decoders"
_ARCH=$(uname -m)
case "${_ARCH}" in
    x86_64)       WSPRD_BIN="${_DECODER_DIR}/wsprd-x86-v27"
                  JT9_BIN="${_DECODER_DIR}/jt9-x86-v27" ;;
    aarch64)      WSPRD_BIN="${_DECODER_DIR}/wsprd-arm64-v27"
                  JT9_BIN="${_DECODER_DIR}/jt9-arm64-v27" ;;
    armv7l|armhf) WSPRD_BIN="${_DECODER_DIR}/wsprd-armhf-v26"
                  JT9_BIN="${_DECODER_DIR}/jt9-arm32-v26" ;;
    *)  echo "wd-decode: unsupported architecture ${_ARCH}" >&2; exit 1 ;;
esac

if [[ ! -x "${WSPRD_BIN}" ]]; then
    echo "wd-decode: wsprd binary not found: ${WSPRD_BIN}" >&2
    exit 1
fi

: "${WD_RECEIVER_NAME:?}"
: "${WD_RECEIVER_TYPE:?}"
: "${WD_RECEIVER_BAND:?}"
: "${WD_RECEIVER_MODES:?}"
: "${WD_RECEIVER_FREQ_HZ:?}"
: "${WD_RECORDING_DIR:?}"
: "${WD_POSTING_DIR:?}"
: "${WD_RUN_DIR:?}"

mkdir -p "${WD_POSTING_DIR}"

# Persistent wsprd working directory — holds ALL_WSPR.TXT hash table across decode cycles.
# Lives on tmpfs (/run) so it persists within a session but not across reboots.
WSPRD_STATE_DIR="${WD_RUN_DIR}/wsprd/${WD_RECEIVER_NAME}/${WD_RECEIVER_BAND}"
mkdir -p "${WSPRD_STATE_DIR}"
readonly MAX_ALL_WSPR_SIZE=200000   # ~200KB — truncate when exceeded (v3 uses same limit)

# Parse mode list (colon-separated: W2:F2:F5)
IFS=':' read -ra MODES <<< "${WD_RECEIVER_MODES}"

echo "wd-decode: ${WD_RECEIVER_NAME} band ${WD_RECEIVER_BAND}"
echo "  modes: ${WD_RECEIVER_MODES}"
echo "  recording dir: ${WD_RECORDING_DIR}"
echo "  posting dir: ${WD_POSTING_DIR}"

# Determine file watching method based on receiver type
use_inotify=false
if [[ "${WD_RECEIVER_TYPE}" == "ka9q" || "${WD_RECEIVER_TYPE}" == "ka9q_wwv" ]]; then
    use_inotify=true
fi

decode_window() {
    # $1 = mode string (e.g., W2, F2, F5)
    local mode="$1"
    local prefix="${mode:0:1}"
    local window="${mode:1}"
    local freq_hz="${WD_RECEIVER_FREQ_HZ}"

    # Collect the N most recent wav files for this window duration
    local wav_files
    wav_files=$(find "${WD_RECORDING_DIR}" -maxdepth 1 -name '*.wav' \
                -printf '%T@\t%p\n' 2>/dev/null | sort -rn | head -"${window}" | \
                sort -n | cut -f2)

    local file_count
    file_count=$(echo "${wav_files}" | grep -c . 2>/dev/null || echo 0)

    if (( file_count < window )); then
        return 0  # Not enough files yet for this window
    fi

    # Create temp directory for decode work
    local work_dir
    work_dir=$(mktemp -d "/tmp/wd-decode-${WD_RECEIVER_NAME}-${WD_RECEIVER_BAND}-XXXXXX")
    trap "rm -rf '${work_dir}'" RETURN

    # Derive a WSPR-format timestamp filename (YYMMDD_HHMM.wav) so wsprd
    # embeds the correct date/time in ALL_WSPR.TXT output lines.
    # KA9Q filenames: 20260408T014800Z_7038600_usb.wav → 260408_0148
    local first_wav
    first_wav="${wav_files%%$'\n'*}"  # first line without spawning a subshell pipe
    local wspr_ts
    local fn_base
    fn_base=$(basename "${first_wav}" .wav)
    if [[ "${fn_base}" =~ ^20([0-9]{6})T([0-9]{2})([0-9]{2})[0-9]{2}Z ]]; then
        wspr_ts="${BASH_REMATCH[1]}_${BASH_REMATCH[2]}${BASH_REMATCH[3]}"
    else
        wspr_ts=$(date -u +%y%m%d_%H%M)
    fi

    # Concatenate wav files with sox → 16-bit PCM
    local concat_wav="${work_dir}/${wspr_ts}.wav"
    # shellcheck disable=SC2086
    sox ${wav_files} -b 16 -e signed-integer "${concat_wav}" 2>/dev/null

    if [[ ! -s "${concat_wav}" ]]; then
        echo "wd-decode: sox concatenation failed for mode ${mode}"
        return 1
    fi

    # Run decoder based on prefix
    local spots_file="${work_dir}/spots.txt"
    local freq_mhz
    freq_mhz=$(echo "scale=6; ${freq_hz}/1000000" | bc)

    case "${prefix}" in
        W)
            # wsprd appends new spots to ALL_WSPR.TXT (not stdout).
            # We diff before/after to find the newly added lines.
            # ALL_WSPR.TXT is also the decoder's hash table — it must persist across cycles.
            local all_wspr="${WSPRD_STATE_DIR}/ALL_WSPR.TXT"
            local all_wspr_save="${WSPRD_STATE_DIR}/ALL_WSPR.TXT.save"

            # Ensure the file exists, then sort and save the pre-decode state
            touch "${all_wspr}"
            sort -k1,2 -k5,5 "${all_wspr}" > "${all_wspr_save}"
            cp -p "${all_wspr_save}" "${all_wspr}"

            # Run wsprd — appends new spots to ALL_WSPR.TXT
            "${WSPRD_BIN}" -a "${WSPRD_STATE_DIR}" -f "${freq_mhz}" "${concat_wav}" \
                > /dev/null 2>&1 || true

            # Sort updated ALL_WSPR.TXT and diff to find new spots
            sort -k1,2 -k5,5 "${all_wspr}" > "${WSPRD_STATE_DIR}/sort.tmp"
            mv "${WSPRD_STATE_DIR}/sort.tmp" "${all_wspr}"
            comm --nocheck-order -13 "${all_wspr_save}" "${all_wspr}" \
                | sort -k1,2 -k5,5 > "${spots_file}" || true

            # Truncate ALL_WSPR.TXT if it exceeds the size limit to prevent unbounded growth
            local all_wspr_size
            all_wspr_size=$(stat -c%s "${all_wspr}" 2>/dev/null || echo 0)
            if (( all_wspr_size > MAX_ALL_WSPR_SIZE )); then
                tail -c "${MAX_ALL_WSPR_SIZE}" "${all_wspr}" > "${WSPRD_STATE_DIR}/trunc.tmp"
                mv "${WSPRD_STATE_DIR}/trunc.tmp" "${all_wspr}"
            fi
            ;;
        F)
            # jt9 FST4W decoder.
            # -f 1500: audio center frequency offset in Hz (not RF MHz)
            # -F 100: +/- 100 Hz search tolerance
            # plotspec/decdata markers enable extended output to fst4_decodes.dat
            # Basic decoded spots (per run) go to decoded.txt.
            local period_sec=$(( window * 60 ))
            touch "${work_dir}/plotspec" "${work_dir}/decdata"
            "${JT9_BIN}" -a "${work_dir}" -t "${work_dir}" --fst4w \
                -p "${period_sec}" -f 1500 -F 100 "${concat_wav}" \
                > "${work_dir}/jt9_output.txt" 2>&1 || true
            # decoded.txt has the basic spot lines from this run
            if [[ -s "${work_dir}/decoded.txt" ]]; then
                cp "${work_dir}/decoded.txt" "${spots_file}"
            fi
            ;;
        I)
            # IQ recording — no decode, just archive
            return 0
            ;;
        *)
            echo "wd-decode: unknown mode prefix: ${prefix}"
            return 1
            ;;
    esac

    # Move spots to posting directory if we got any
    if [[ -s "${spots_file}" ]]; then
        local timestamp
        timestamp=$(date -u +%Y%m%d_%H%M%S)
        local dest="${WD_POSTING_DIR}/${WD_RECEIVER_NAME}_${WD_RECEIVER_BAND}_${mode}_${timestamp}_spots.txt"
        mv "${spots_file}" "${dest}"
        echo "wd-decode: ${mode} → $(wc -l < "${dest}") spots → ${dest}"
    fi
}

cleanup_old_wavs() {
    # Find the largest window across all modes — that's how many wav files we need to keep.
    local max_window=2
    for mode in "${MODES[@]}"; do
        local w="${mode:1}"
        (( w > max_window )) && max_window="${w}"
    done
    # Keep max_window + 1 files as a buffer; delete everything older.
    local keep=$(( max_window + 1 ))
    find "${WD_RECORDING_DIR}" -maxdepth 1 -name '*.wav' -printf '%T@\t%p\n' 2>/dev/null | \
        sort -rn | tail -n +$(( keep + 1 )) | cut -f2 | xargs -r rm -f
    find "${WD_RECORDING_DIR}" -maxdepth 1 -name '*.json' -printf '%T@\t%p\n' 2>/dev/null | \
        sort -rn | tail -n +$(( keep + 1 )) | cut -f2 | xargs -r rm -f
}

run_decode_cycle() {
    for mode in "${MODES[@]}"; do
        decode_window "${mode}" || true
    done
    cleanup_old_wavs
}

# Main loop
if ${use_inotify}; then
    echo "wd-decode: using inotifywait for ${WD_RECEIVER_TYPE} source"
    while true; do
        # wspr-recorder writes .wav.tmp then renames → MOVED_TO .wav,
        # then writes a .json sidecar via CLOSE_WRITE. Trigger on either
        # so the decode fires once the wav is fully in place.
        inotifywait -q -e moved_to -e close_write -t 120 "${WD_RECORDING_DIR}" \
            --include '\.(wav|json)$' >/dev/null 2>&1 || true
        run_decode_cycle
    done
else
    echo "wd-decode: using polling for ${WD_RECEIVER_TYPE} source"
    while true; do
        sleep 60  # Poll every minute (matches kiwi_recorder 1-min wav cycle)
        run_decode_cycle
    done
fi
