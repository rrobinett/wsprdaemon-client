#!/usr/bin/env python3
"""wd-upload-wsprdaemon — upload WSPR spots to wsprdaemon.org via SFTP or FTP tar bundle.

One instance per reporter CALL+GRID. Watches the upload queue tree for spot
files produced by wd-post, bundles them (≤MAX_FILES) into a bzip2 tar, and
uploads the bundle via SFTP (preferred) or FTP (fallback).

SFTP protocol: puts file as uploads/NAME.tbz.part then renames to remove .part,
matching the v3 convention so the server never processes a partial file.
SFTP host key changes are handled automatically (ssh-keygen -R + retry with
StrictHostKeyChecking=accept-new).

On success: deletes processed files, removes empty directories.
On failure: leaves files in queue and retries after RETRY_SECS.

Environment variables:
    WD_UPLOAD_WSPRDAEMON_DIR   Root of queue tree (e.g. .../wsprdaemon/AC0G=B1)
    WD_RECEIVER_CALL           Reporter callsign (e.g. AC0G/B1)
    WD_UPLOAD_ID               Tar file name prefix (e.g. AC0G_B1)
    WD_VERSION                 Version string embedded in config (default: 4.0)
    WD_BURST_THRESHOLD         File count for immediate upload (default: 15)

    SFTP (primary — set WD_SFTP_SERVERS to enable):
    WD_SFTP_SERVERS            Comma-separated user@host list, tried in order.
                               Falls back to WD_SFTP_SERVER if not set.
                               e.g. wsprdaemon@gw1.wsprdaemon.org,wsprdaemon@gw2.wsprdaemon.org
    WD_SFTP_SERVER             Single user@host (legacy; used if WD_SFTP_SERVERS not set)
    WD_SFTP_PATH               Remote directory for uploads (default: uploads)
    WD_SFTP_CONNECT_TIMEOUT    Connection timeout seconds (default: 10)
    WD_SFTP_XFER_TIMEOUT       Transfer timeout seconds (default: 90)

    FTP (fallback when all SFTP attempts fail or SFTP not configured):
    WD_FTP_SERVERS             Comma-separated hostname list, tried in order.
                               Falls back to WD_FTP_SERVER if not set.
                               e.g. gw1.wsprdaemon.org,gw2.wsprdaemon.org
    WD_FTP_SERVER              Single hostname (legacy; used if WD_FTP_SERVERS not set)
    WD_FTP_USER                FTP username (default: noisegraphs)
    WD_FTP_PASSWORD            FTP password (default: xahFie6g)
    WD_FTP_PATH                FTP upload path (default: upload)

    WD_MAX_FILES               Max spot files per tar bundle (default: 10000)
"""

import ftplib
import io
import logging
import os
import re
import subprocess
import sys
import tarfile
import tempfile
import time
from pathlib import Path

_HERE = Path(__file__).resolve().parent
for _p in ['/opt/wsprdaemon/lib', str(_HERE.parent / 'lib')]:
    if Path(_p).exists() and _p not in sys.path:
        sys.path.insert(0, _p)

log = logging.getLogger('wd-upload-wsprdaemon')

UPLOAD_DIR      = Path(os.environ['WD_UPLOAD_WSPRDAEMON_DIR'])
REPORTER_CALL   = os.environ['WD_RECEIVER_CALL']       # e.g. AC0G/B1
UPLOAD_ID       = os.environ.get('WD_UPLOAD_ID',
                      REPORTER_CALL.replace('/', '_'))  # e.g. AC0G_B1
VERSION         = os.environ.get('WD_VERSION', '4.0')

# SFTP servers — tried in order until one succeeds.
# WD_SFTP_SERVERS / WD_SFTP_SERVER contain hostnames only (no user@).
# The SFTP login user is derived from the reporter call (AC0G/B1 → AC0G_B1).
def _parse_servers(multi_var: str, single_var: str, default: str = '') -> list[str]:
    raw = os.environ.get(multi_var) or os.environ.get(single_var, default)
    return [s.strip() for s in raw.split(',') if s.strip()]

def _host_only(s: str) -> str:
    """Strip user@ prefix if present, returning just the hostname."""
    return s.split('@')[-1]

SFTP_USER           = os.environ.get('WD_SFTP_USER', UPLOAD_ID)  # e.g. AC0G_B1
SFTP_SERVERS        = [_host_only(h) for h in _parse_servers('WD_SFTP_SERVERS', 'WD_SFTP_SERVER')]
SFTP_PATH           = os.environ.get('WD_SFTP_PATH', 'uploads')
SFTP_CONNECT_TIMEOUT = int(os.environ.get('WD_SFTP_CONNECT_TIMEOUT', '10'))
SFTP_XFER_TIMEOUT   = int(os.environ.get('WD_SFTP_XFER_TIMEOUT', '90'))

# FTP servers — tried in order after all SFTP attempts fail.
# FTP (noisegraphs legacy) only exists on gw2; gw1 has no FTP listener.
FTP_SERVERS     = _parse_servers('WD_FTP_SERVERS', 'WD_FTP_SERVER', 'gw2.wsprdaemon.org')
FTP_USER        = os.environ.get('WD_FTP_USER', 'noisegraphs')
FTP_PASSWORD    = os.environ.get('WD_FTP_PASSWORD', 'xahFie6g')
FTP_PATH        = os.environ.get('WD_FTP_PATH', 'upload')
FTP_TIMEOUT     = 90          # seconds

MAX_FILES       = int(os.environ.get('WD_MAX_FILES', '10000'))
BURST_THRESHOLD = int(os.environ.get('WD_BURST_THRESHOLD', '15'))
STABILITY_SECS  = 10          # file count must be stable before uploading
CHECK_INTERVAL  = 2           # polling interval during stability check
RETRY_SECS      = 60          # pause after network/server error
UPLOAD_INTERVAL = 10          # minimum seconds between successful uploads


# ---------------------------------------------------------------------------
# File collection
# ---------------------------------------------------------------------------

def collect_files() -> list:
    """Return all uploadable files in queue tree, sorted oldest-first.

    The wsprdaemon queue directory receives three file types from wd-post:
      *_wd_spots.txt   — extended 34-field spots (W-mode)
      *_spots.txt      — short 11-field spots (F-mode only; W-mode goes to wsprnet queue)
      noise/*_noise.txt — 15-field per-cycle noise measurements (W-mode)
    """
    candidates = (
        list(UPLOAD_DIR.rglob('*_wd_spots.txt'))
        + list(UPLOAD_DIR.rglob('*_spots.txt'))
        + list(UPLOAD_DIR.rglob('*_noise.txt'))
    )
    return sorted(set(candidates), key=lambda p: p.stat().st_mtime)


# ---------------------------------------------------------------------------
# Tar bundle creation
# ---------------------------------------------------------------------------

def _config_bytes() -> bytes:
    """Create a minimal uploads_config.txt to include in the tar."""
    lines = [
        f'CLIENT_VERSION={VERSION}',
        'UPLOADS_WSPRNET_LINE_FORMAT_VERSION=1',
        'UPLOADS_WSPRDAEMON_SPOT_LINE_FORMAT_VERSION=3',
        'SIGNAL_LEVEL_UPLOAD=yes',
    ]
    return '\n'.join(lines).encode() + b'\n'


def get_or_create_ssh_pubkey() -> str:
    """Return the wsprdaemon user's SSH public key, generating one if needed."""
    ssh_dir = Path.home() / '.ssh'
    ssh_dir.mkdir(mode=0o700, exist_ok=True)

    for candidate in ('id_ed25519', 'id_rsa', 'id_ecdsa'):
        pub = ssh_dir / f'{candidate}.pub'
        if pub.exists():
            return pub.read_text().strip()

    # No key found — generate ed25519
    key = ssh_dir / 'id_ed25519'
    log.info('no SSH key found — generating %s', key)
    subprocess.run(
        ['ssh-keygen', '-t', 'ed25519', '-f', str(key), '-N', '', '-C',
         f'wsprdaemon@{REPORTER_CALL.replace("/", "_")}'],
        check=True, capture_output=True,
    )
    return (ssh_dir / 'id_ed25519.pub').read_text().strip()


def _client_info_bytes() -> bytes:
    """Build client_upload_info.txt content: reporter_id + SSH public key."""
    try:
        pubkey = get_or_create_ssh_pubkey()
    except Exception as e:
        log.warning('could not get SSH public key: %s', e)
        pubkey = ''
    lines = [
        f'reporter_id={REPORTER_CALL}',
        f'ssh_public_key={pubkey}',
    ]
    return '\n'.join(lines).encode() + b'\n'


def _tar_add_bytes(tf: tarfile.TarFile, arcname: str, data: bytes) -> None:
    ti = tarfile.TarInfo(name=arcname)
    ti.size = len(data)
    ti.mtime = int(time.time())
    tf.addfile(ti, io.BytesIO(data))


def build_tar(files: list, tar_path: Path, include_client_info: bool = False) -> int:
    """
    Create a bzip2 tar at tar_path containing the given spot files.
    Paths inside the tar are prefixed with 'wsprdaemon/' relative to UPLOAD_DIR.
    When include_client_info is True, adds client_upload_info.txt so the server
    can provision SFTP access for this reporter.
    Returns the total bytes of spot data included.
    """
    total_bytes = 0
    with tarfile.open(tar_path, 'w:bz2') as tf:
        _tar_add_bytes(tf, 'wsprdaemon/uploads_config.txt', _config_bytes())

        if include_client_info:
            _tar_add_bytes(tf, 'wsprdaemon/client_upload_info.txt', _client_info_bytes())

        for f in files:
            try:
                rel = f.relative_to(UPLOAD_DIR)
            except ValueError:
                rel = Path(f.name)
            arcname = f'wsprdaemon/{rel}'
            try:
                total_bytes += f.stat().st_size
                tf.add(str(f), arcname=arcname, recursive=False)
            except OSError as e:
                log.warning('cannot add %s to tar: %s', f, e)

    return total_bytes


# ---------------------------------------------------------------------------
# SFTP upload (primary, when WD_SFTP_SERVER is set)
# ---------------------------------------------------------------------------

def _sftp_batch_cmd(tar_path: Path, tar_name: str) -> bytes:
    """Return the sftp batch commands for a .part-then-rename upload."""
    part = f'{SFTP_PATH}/{tar_name}.part'
    dest = f'{SFTP_PATH}/{tar_name}'
    return f'put {tar_path} {part}\nrename {part} {dest}\n'.encode()


def _port_open(host: str, port: int, timeout: int = 3) -> bool:
    """Return True if host:port accepts a TCP connection within timeout seconds."""
    result = subprocess.run(
        ['nc', '-z', '-w', str(timeout), host, str(port)],
        capture_output=True,
    )
    return result.returncode == 0


def _run_sftp(server: str, batch_cmd: bytes, extra_opts: list = None) -> tuple:
    """
    Run sftp in batch mode. Returns (returncode, combined_output).
    extra_opts: additional -o options (list of strings).
    """
    opts = extra_opts or []
    cmd = [
        'sftp', '-b', '-',
        '-o', 'BatchMode=yes',
        '-o', f'ConnectTimeout={SFTP_CONNECT_TIMEOUT}',
    ]
    for opt in opts:
        cmd += ['-o', opt]
    cmd.append(f'{SFTP_USER}@{server}')

    try:
        result = subprocess.run(
            cmd,
            input=batch_cmd,
            capture_output=True,
            timeout=SFTP_XFER_TIMEOUT,
        )
        output = result.stdout + result.stderr
        return result.returncode, output.decode(errors='replace')
    except subprocess.TimeoutExpired:
        return 1, 'sftp timed out'


def _sftp_remove_host_key(server: str) -> None:
    """Remove the SFTP server's entry from known_hosts (handles key rotation)."""
    host = server  # server is already host-only
    subprocess.run(['ssh-keygen', '-f',
                    str(Path.home() / '.ssh' / 'known_hosts'),
                    '-R', host],
                   capture_output=True)
    # Also try removal by IP
    try:
        result = subprocess.run(['getent', 'hosts', host],
                                capture_output=True, text=True, timeout=5)
        ip = result.stdout.split()[0] if result.stdout.strip() else ''
        if ip:
            subprocess.run(['ssh-keygen', '-f',
                            str(Path.home() / '.ssh' / 'known_hosts'),
                            '-R', ip],
                           capture_output=True)
    except Exception:
        pass


_HOST_KEY_ERR = re.compile(
    r'REMOTE HOST IDENTIFICATION HAS CHANGED|'
    r'Host key verification failed|'
    r'host key.*has changed',
    re.I,
)


def sftp_put(server: str, tar_path: Path, tar_name: str) -> bool:
    """
    Upload to server via SFTP using .part-then-rename convention.
    Handles host key changes automatically (one retry).
    Returns True on success, False on failure.
    """
    batch = _sftp_batch_cmd(tar_path, tar_name)
    rc, output = _run_sftp(server, batch)
    if rc == 0:
        return True

    if _HOST_KEY_ERR.search(output):
        log.warning('SFTP host key changed for %s — removing old key and retrying',
                    server.split('@')[-1])
        _sftp_remove_host_key(server)
        rc, output = _run_sftp(server, batch, extra_opts=['StrictHostKeyChecking=accept-new'])
        if rc == 0:
            log.info('SFTP upload succeeded after host key update')
            return True

    log.warning('SFTP upload failed (rc=%d): %s', rc, output.strip()[-200:])
    return False


# ---------------------------------------------------------------------------
# FTP upload (fallback)
# ---------------------------------------------------------------------------

def ftp_put(server: str, tar_path: Path, tar_name: str) -> None:
    """Upload tar_path to server/FTP_PATH/tar_name via FTP.
    Raises OSError immediately if port 21 is closed."""
    if not _port_open(server, 21):
        raise OSError(f'FTP port 21 closed on {server}')
    with ftplib.FTP(timeout=FTP_TIMEOUT) as ftp:
        ftp.connect(server)
        ftp.login(user=FTP_USER, passwd=FTP_PASSWORD)
        ftp.set_pasv(True)
        with tar_path.open('rb') as f:
            ftp.storbinary(f'STOR {FTP_PATH}/{tar_name}', f)


# ---------------------------------------------------------------------------
# Upload dispatcher
# ---------------------------------------------------------------------------

def try_sftp(tar_path: Path, tar_name: str) -> bool:
    """Try each SFTP server in order. Returns True on first success."""
    for server in SFTP_SERVERS:
        log.info('attempting SFTP upload to %s', server)
        if sftp_put(server, tar_path, tar_name):
            log.info('SFTP upload successful to %s', server)
            return True
        log.warning('SFTP to %s failed — trying next', server)
    if SFTP_SERVERS:
        log.warning('all SFTP servers failed')
    return False


def try_ftp(tar_path: Path, tar_name: str) -> bool:
    """Try each FTP server in order. Returns True on first success."""
    for server in FTP_SERVERS:
        try:
            log.info('attempting FTP upload to %s', server)
            ftp_put(server, tar_path, tar_name)
            log.info('FTP upload successful to %s', server)
            return True
        except (ftplib.Error, OSError) as e:
            log.warning('FTP to %s failed: %s — trying next', server, e)
    log.warning('all FTP servers failed')
    return False


# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------

def remove_files(files: list) -> None:
    """Delete uploaded spot files; prune now-empty directories."""
    dirs_to_check = set()
    for f in files:
        try:
            f.unlink(missing_ok=True)
            dirs_to_check.add(f.parent)
        except OSError as e:
            log.warning('cannot remove %s: %s', f, e)

    # Prune directories bottom-up (skip UPLOAD_DIR itself)
    for d in sorted(dirs_to_check, key=lambda p: len(p.parts), reverse=True):
        if d == UPLOAD_DIR:
            continue
        try:
            d.rmdir()   # only succeeds if empty
        except OSError:
            pass


# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------

def main() -> int:
    logging.basicConfig(
        level=logging.INFO,
        format='%(asctime)sZ %(name)s %(levelname)s %(message)s',
        datefmt='%Y-%m-%dT%H:%M:%S',
    )
    transport = (f'SFTP{SFTP_SERVERS}→FTP{FTP_SERVERS}' if SFTP_SERVERS
                 else f'FTP{FTP_SERVERS}')
    log.info('starting: reporter %s  upload_id %s  transport: %s  queue: %s',
             REPORTER_CALL, UPLOAD_ID, transport, UPLOAD_DIR)
    UPLOAD_DIR.mkdir(parents=True, exist_ok=True)

    while True:
        # Phase 1: wait for any files to appear
        while not collect_files():
            time.sleep(10)

        # Phase 2: stability / burst check
        prev_count = len(collect_files())
        stable_since = time.monotonic()

        while True:
            time.sleep(CHECK_INTERVAL)
            curr_count = len(collect_files())
            if curr_count >= BURST_THRESHOLD:
                log.info('burst threshold (%d files) — uploading immediately', curr_count)
                break
            if curr_count == prev_count:
                if time.monotonic() - stable_since >= STABILITY_SECS:
                    break
            else:
                prev_count = curr_count
                stable_since = time.monotonic()

        # Phase 3: collect files for this batch (up to MAX_FILES)
        files = collect_files()
        if len(files) > MAX_FILES:
            log.info('capping batch: %d → %d files', len(files), MAX_FILES)
            files = files[:MAX_FILES]

        if not files:
            time.sleep(10)
            continue

        # Phase 4: create tar bundle and upload
        ts = time.strftime('%y%m%d_%H%M_%S', time.gmtime())
        tar_name = f'{UPLOAD_ID}_{ts}.tbz'

        with tempfile.TemporaryDirectory() as tmpdir:
            tar_path = Path(tmpdir) / tar_name
            total_bytes = build_tar(files, tar_path)
            tar_size = tar_path.stat().st_size

            log.info('uploading %d files / %d spot-bytes → %s (%d tar bytes)',
                     len(files), total_bytes, tar_name, tar_size)
            for f in files:
                try:
                    tag = 'noise' if '_noise.txt' in f.name else \
                          'wd'    if '_wd_spots.txt' in f.name else 'spot'
                    for line in f.read_text().splitlines():
                        if line.strip():
                            log.info('%s  [%s]  %s', tag, f.parent.name, line)
                except OSError:
                    pass

            # Phase 5: try SFTP first (no client_info needed — SSH key is the identity)
            success = try_sftp(tar_path, tar_name)

            # Phase 6: SFTP failed — rebuild tar with client_upload_info and try FTP.
            # client_upload_info lets the server provision SFTP access for this reporter.
            if not success and FTP_SERVERS:
                log.info('rebuilding tar with client_upload_info for FTP upload')
                ftp_tar_path = Path(tmpdir) / f'ftp_{tar_name}'
                build_tar(files, ftp_tar_path, include_client_info=True)
                success = try_ftp(ftp_tar_path, tar_name)

            if not success:
                log.warning('all upload methods failed — retrying in %ds', RETRY_SECS)
                time.sleep(RETRY_SECS)
                continue

        log.info('upload complete — deleting %d source files', len(files))
        remove_files(files)

        time.sleep(UPLOAD_INTERVAL)


if __name__ == '__main__':
    sys.exit(main())
