#!/bin/bash
# /usr/local/sbin/wd-post
# Posting daemon — collects decoded spot files from the posting directory
# and queues them for upload:
#   - wsprnet.org:      short 11-field spots (all modes, merged by uploader)
#   - wsprdaemon.org:   extended 34-field _wd_spots.txt (W-modes)
#                       short _spots.txt (F-modes, no extended version)
#                       noise/_noise.txt (per-cycle noise measurements, W-modes)
#
# File naming from wd-decode:
#   RECV_BAND_W2_TS_spots.txt      → wsprnet only  (W-mode short)
#   RECV_BAND_W2_TS_wd_spots.txt   → wsprdaemon    (W-mode extended)
#   RECV_BAND_W2_TS_noise.txt      → wsprdaemon noise/ (W-mode noise)
#   RECV_BAND_F2_TS_spots.txt      → both          (F-mode, no extended version)

set -euo pipefail

# Contract §11 log-level resolution + SIGHUP handler.
for _d in /opt/wsprdaemon-client/lib /usr/local/share/wsprdaemon/lib; do
    if [[ -r "${_d}/wd-loglevel.sh" ]]; then
        # shellcheck source=/dev/null
        . "${_d}/wd-loglevel.sh"
        break
    fi
done

: "${WD_RECEIVER_NAME:?}"
: "${WD_RECEIVER_BAND:?}"
: "${WD_POSTING_DIR:?}"
: "${WD_RECEIVER_CALL:?}"
: "${WD_RECEIVER_GRID:?}"

echo "wd-post: ${WD_RECEIVER_NAME} band ${WD_RECEIVER_BAND}"
echo "  posting dir: ${WD_POSTING_DIR}"

# Upload directories
WSPRNET_DIR="${WD_UPLOAD_WSPRNET_DIR:-}"
WSPRDAEMON_DIR="${WD_UPLOAD_WSPRDAEMON_DIR:-}"
# Noise files go into a noise/ subdirectory under the wsprdaemon upload tree
# so the uploader bundles them in the same .tbz archive as spots.
WSPRDAEMON_NOISE_DIR=""
[[ -n "${WSPRDAEMON_DIR}" ]] && WSPRDAEMON_NOISE_DIR="${WSPRDAEMON_DIR}/noise"

[[ -n "${WSPRNET_DIR}" ]]          && mkdir -p "${WSPRNET_DIR}"
[[ -n "${WSPRDAEMON_DIR}" ]]       && mkdir -p "${WSPRDAEMON_DIR}"
[[ -n "${WSPRDAEMON_NOISE_DIR}" ]] && mkdir -p "${WSPRDAEMON_NOISE_DIR}"

while true; do
    inotifywait -q -e moved_to -e close_write -t 5 "${WD_POSTING_DIR}" \
        --include '(wd_spots|_spots|_noise)\.txt$' >/dev/null 2>&1 || true

    # Re-create upload dirs each cycle — the uploader prunes empty dirs after upload.
    [[ -n "${WSPRNET_DIR}" ]]          && mkdir -p "${WSPRNET_DIR}"
    [[ -n "${WSPRDAEMON_DIR}" ]]       && mkdir -p "${WSPRDAEMON_DIR}"
    [[ -n "${WSPRDAEMON_NOISE_DIR}" ]] && mkdir -p "${WSPRDAEMON_NOISE_DIR}"

    shopt -s nullglob
    pending=(
        "${WD_POSTING_DIR}"/*_wd_spots.txt
        "${WD_POSTING_DIR}"/*_noise.txt
        "${WD_POSTING_DIR}"/*_spots.txt
    )
    shopt -u nullglob

    for f in "${pending[@]}"; do
        [[ -s "${f}" ]] || { rm -f "${f}"; continue; }

        bn=$(basename "${f}")
        age=$(( $(date -u +%s) - $(stat -c %Y "${f}") ))
        if (( age > 600 )); then
            echo "wd-post: dropping stale (${age}s): ${bn}"
            rm -f "${f}"; continue
        fi

        if [[ "${bn}" == *_wd_spots.txt ]]; then
            # Extended W-mode spots → wsprdaemon SFTP queue (canonical path).
            [[ -n "${WSPRDAEMON_DIR}" ]] && cp "${f}" "${WSPRDAEMON_DIR}/"

            # CONTRACT v0.6 §17 — local CH staging tier (additive).
            # No-op when SIGMOND_CLICKHOUSE_URL is unset.  When the
            # SFTP path is eventually retired in favor of hs-uploader,
            # the cp above goes away and this call remains as the
            # only sink for these rows.
            #
            # --callhash-path persists the cumulative compound-call
            # cache across invocations under a per-station file in
            # /var/lib/wsprdaemon-client/.  WSJT-X/wsprd brackets
            # `<call>` when it resolved a hash from its session table
            # — observe()ing the line means our cache grows even
            # though wsprd starts empty every cycle.
            if command -v wd-ch-write >/dev/null 2>&1; then
                callhash_dir="/var/lib/wsprdaemon-client/callhash"
                mkdir -p "${callhash_dir}" 2>/dev/null || true
                wd-ch-write \
                    --client-version "${WD_VERSION:-4.0}" \
                    --callhash-path "${callhash_dir}/wspr-callhash.json" \
                    "${f}" \
                    || echo "wd-post: wd-ch-write failed for ${bn} (upload path unaffected)" >&2
            fi

        elif [[ "${bn}" == *_noise.txt ]]; then
            # Noise measurement → wsprdaemon noise subdir only
            [[ -n "${WSPRDAEMON_NOISE_DIR}" ]] && cp "${f}" "${WSPRDAEMON_NOISE_DIR}/"

        else
            # Short spots file (_spots.txt).
            # W-mode: wsprnet only (extended version handles wsprdaemon).
            # F-mode: both queues (no extended version exists for F-modes).
            # Distinguish by mode field in filename: RECV_BAND_MODE_TS_spots.txt
            # Mode field contains W or F as first character.
            local_mode=""
            if [[ "${bn}" =~ _([WF][0-9]+)_ ]]; then
                local_mode="${BASH_REMATCH[1]}"
            fi

            [[ -n "${WSPRNET_DIR}" ]] && cp "${f}" "${WSPRNET_DIR}/"
            if [[ -n "${WSPRDAEMON_DIR}" && "${local_mode:0:1}" != "W" ]]; then
                cp "${f}" "${WSPRDAEMON_DIR}/"
            fi
        fi

        rm -f "${f}"
    done
done
