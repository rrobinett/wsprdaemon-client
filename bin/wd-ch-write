#!/usr/bin/env python3
"""wd-ch-write — parse `_wd_spots.txt` files and insert rows into the
local sigmond staging tier (CONTRACT v0.6 §17).

Standalone-safe: when neither `SIGMOND_CLICKHOUSE_URL` nor
`SIGMOND_SQLITE_PATH` is set (no sigmond install, or sigmond is
running on a different host), `hamsci_ch.Writer.from_env()` returns a
no-op writer that silently discards inserts and exits 0.  The
existing SFTP upload to wsprdaemon.org is not affected by this path
either way.

Backend dispatch is delegated to `Writer.from_env()`:
  - `SIGMOND_CLICKHOUSE_URL` set       → ClickHouse Writer
  - `SIGMOND_SQLITE_PATH` set OR
    /var/lib/sigmond/sink.db present   → SqliteWriter (the post-
                                          `smd storage migrate-to-sqlite`
                                          default)
  - neither                              → no-op

Wire-compat: rows are produced by the same parser used by
`wsprdaemon-server/tar-bulk-loader.py`, so edge-CH rows are byte-equal
to central-CH rows for the same input.

Usage:
    wd-ch-write [--rx-id RX_ID] [--client-version VER] PATH...
"""
from __future__ import annotations

import argparse
import logging
import os
import sys
from pathlib import Path

# Make wdlib importable both from the repo (./lib) and from the
# install layout (/opt/wsprdaemon-client/lib).
_HERE = Path(__file__).resolve()
for _candidate in (
    _HERE.parent.parent / "lib",
    Path("/opt/wsprdaemon-client/lib"),
):
    if (_candidate / "wdlib").exists():
        sys.path.insert(0, str(_candidate))
        break

from wdlib.ch_writer import build_writer, rows_from_spots_file


logging.basicConfig(
    stream=sys.stderr,
    format="%(asctime)s %(levelname)s wd-ch-write: %(message)s",
)
log = logging.getLogger("wd-ch-write")


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="wd-ch-write")
    p.add_argument("--rx-id", default=None,
                   help="rx_id column value (defaults to receiver dir name)")
    p.add_argument("--client-version", default=None,
                   help="value to write into the version column")
    p.add_argument("--batch-rows", type=int, default=50_000,
                   help="hamsci_ch batch size (default: 50000)")
    p.add_argument("--callhash-path", type=Path, default=None,
                   help="path to a CallHashTable JSON file (per-station "
                        "compound-callsign cache).  When provided, "
                        "<call> markers in spot files accumulate over "
                        "invocations.  Default: no persistence.")
    p.add_argument("paths", nargs="+", type=Path)
    args = p.parse_args(argv)

    # Delegate backend selection to hamsci_ch.Writer.from_env: it
    # picks ClickHouse when SIGMOND_CLICKHOUSE_URL is set, SQLite when
    # SIGMOND_SQLITE_PATH is set (or the default /var/lib/sigmond/
    # sink.db exists), and returns a no-op writer otherwise.  The
    # old "early-out when CH is unset" guard incorrectly skipped the
    # SQLite path entirely after the smd storage migrate-to-sqlite
    # rollout — observed on bee1 2026-05-12 where wd-ch-write was
    # still trying to connect to localhost:8123 (long after the CH
    # server was purged) and dropping wspr.spots rows on the floor.
    callhash_table = _load_callhash(args.callhash_path)

    writer = build_writer(batch_rows=args.batch_rows)
    if writer.is_noop:
        log.debug("hamsci_ch writer is no-op; file upload path unaffected")
        return 0
    written = 0
    skipped = 0
    with writer:
        for path in args.paths:
            if not path.exists():
                log.warning("missing file: %s", path)
                skipped += 1
                continue
            try:
                rows = list(rows_from_spots_file(
                    path,
                    rx_id=args.rx_id,
                    client_version=args.client_version,
                    callhash_table=callhash_table,
                ))
            except OSError as e:
                log.warning("read failed for %s: %s", path, e)
                skipped += 1
                continue
            if rows:
                writer.insert(rows)
                written += len(rows)
    if callhash_table is not None and args.callhash_path is not None:
        try:
            callhash_table.save()
        except Exception as exc:
            log.warning("callhash save failed: %s", exc)
    log.info("wrote %d row(s); skipped %d file(s); writer health=%s",
             written, skipped, writer.health)
    return 0


def _load_callhash(path):
    """Load (or initialise) a CallHashTable, returning None if
    sigmond.callhash isn't importable (graceful degradation: bracket
    normalisation in spot_to_ch_row uses the inline fallback)."""
    if path is None:
        return None
    try:
        from sigmond.callhash import CallHashTable
    except ImportError:
        log.debug("sigmond.callhash unavailable; --callhash-path ignored")
        return None
    return CallHashTable.load_or_new(path)


if __name__ == "__main__":
    sys.exit(main())
