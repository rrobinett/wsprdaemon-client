#!/usr/bin/env python3
"""wd-ctl — wsprdaemon v4 orchestrator.

Subcommands:
    apply           Generate env files from current config and ensure services match
    teardown        Stop and disable all wsprdaemon services
    status          Show status of all wsprdaemon services
    validate        Check config for errors without applying
    verbosity       Change log verbosity: up|down SERVICE|all
"""

import argparse
import os
import re
import sys
from pathlib import Path

# Add the lib directory to the path so wdlib is importable
_SCRIPT_DIR = Path(__file__).resolve().parent
_LIB_DIR = _SCRIPT_DIR.parent / 'lib'
if _LIB_DIR.exists():
    sys.path.insert(0, str(_LIB_DIR))
# Also check /opt/wsprdaemon/lib for installed location
elif Path('/opt/wsprdaemon/lib').exists():
    sys.path.insert(0, '/opt/wsprdaemon/lib')

from wdlib import paths
from wdlib.v4_parser import parse_v4_config
from wdlib.envgen import generate_all_env_files


def _parse_cpu_list(s: str) -> tuple:
    """Parse a Linux CPU list string ('0-1', '0,8', '0-1,8-9') into a sorted tuple."""
    cpus = []
    for part in s.split(','):
        part = part.strip()
        if '-' in part:
            lo, hi = part.split('-', 1)
            cpus.extend(range(int(lo), int(hi) + 1))
        elif part:
            cpus.append(int(part))
    return tuple(sorted(cpus))


def _get_ht_pairs() -> list:
    """Return sorted list of hyperthreading sibling groups from the OS.

    Each element is a tuple of CPU IDs that share a physical core.
    On non-HT systems each tuple has one element.
    Sorted by lowest CPU ID in the group.
    """
    import glob as _glob
    seen: set = set()
    pairs: list = []
    cpu_dirs = sorted(
        _glob.glob('/sys/devices/system/cpu/cpu[0-9]*'),
        key=lambda p: int(re.sub(r'.*cpu', '', p))
    )
    for d in cpu_dirs:
        try:
            raw = Path(f'{d}/topology/thread_siblings_list').read_text().strip()
            group = _parse_cpu_list(raw)
        except (OSError, ValueError):
            cpu_id = int(re.sub(r'.*cpu', '', d))
            group = (cpu_id,)
        key = frozenset(group)
        if key not in seen:
            seen.add(key)
            pairs.append(group)
    return sorted(pairs, key=lambda g: g[0])


def _get_radiod_cpu_assignments() -> dict:
    """Return {radiod_name: frozenset(cpus)} from all existing cpu-affinity.conf drop-ins."""
    import glob as _glob
    result = {}
    for path in _glob.glob('/etc/systemd/system/radiod@*.service.d/cpu-affinity.conf'):
        m = re.search(r'radiod@(.+)\.service\.d', path)
        if not m:
            continue
        name = m.group(1)
        try:
            content = Path(path).read_text()
            ma = re.search(r'^CPUAffinity\s*=\s*(.+)$', content, re.MULTILINE)
            if ma:
                result[name] = frozenset(int(c) for c in ma.group(1).split())
        except (OSError, ValueError):
            pass
    return result


def _apply_radiod_cpu_affinity(radiod_name: str, cpus: tuple) -> None:
    """Write (or update) the cpu-affinity.conf drop-in for radiod@<radiod_name>."""
    drop_in_dir = Path(f'/etc/systemd/system/radiod@{radiod_name}.service.d')
    drop_in_dir.mkdir(parents=True, exist_ok=True)
    conf_path = drop_in_dir / 'cpu-affinity.conf'
    cpu_str = ' '.join(str(c) for c in cpus)
    lines = ['[Service]', f'CPUAffinity={cpu_str}']
    # Only add pin script line if it exists on this host
    pin_script = Path('/usr/local/bin/pin-radiod-threads.sh')
    if pin_script.exists():
        pin_args = ' '.join(str(c) for c in cpus)
        lines.append(f'ExecStartPost={pin_script} $MAINPID {pin_args}')
    conf_path.write_text('\n'.join(lines) + '\n')
    print(f'  radiod@{radiod_name}: CPUAffinity={cpu_str}')


def _all_cpus() -> list:
    """Return sorted list of all logical CPU IDs on this host."""
    import glob as _glob2
    cpus = []
    for d in _glob2.glob('/sys/devices/system/cpu/cpu[0-9]*'):
        try:
            cpus.append(int(re.sub(r'.*cpu', '', d)))
        except ValueError:
            pass
    return sorted(cpus)


def _apply_worker_cpu_affinity(reserved: set) -> None:
    """Write 99-wdctl-cpu-affinity.conf drop-ins for all wd-ctl-managed services.

    Worker CPUs = all CPUs minus the reserved set (wd-ctl radiod + user-specified).
    Writes drop-ins for:
      - wd-* template service families
      - timestd-* pipeline services
    Also disables hf-timestd's own affinity watcher so it can't override us.
    """
    import subprocess

    worker = [c for c in _all_cpus() if c not in reserved]
    if not worker:
        print('  WARNING: no worker CPUs remaining after reservations — skipping affinity',
              file=sys.stderr)
        return

    cpu_str = ' '.join(str(c) for c in worker)
    drop_in_content = f'[Service]\nCPUAffinity=\nCPUAffinity={cpu_str}\n'

    # Unit templates and singletons to pin to worker CPUs.
    # Use the base template name (without instance) for @ services.
    units = [
        # wd-ctl-managed templates
        'wd-ka9q-record@.service',
        'wd-kiwi-record@.service',
        'wd-decode@.service',
        'wd-post@.service',
        'wd-ka9q-web@.service',
        'wd-spool-clean.service',
        # hf-timestd pipeline services
        'timestd-core-recorder.service',
        'timestd-metrology@.service',
        'timestd-l2-calibration.service',
        'timestd-fusion.service',
        'timestd-physics.service',
        'timestd-web-api.service',
        'timestd-radiod-monitor.service',
    ]

    unit_dir = Path('/etc/systemd/system')
    for unit in units:
        drop_in_dir = unit_dir / f'{unit}.d'
        drop_in_dir.mkdir(parents=True, exist_ok=True)
        conf = drop_in_dir / '99-wdctl-cpu-affinity.conf'
        conf.write_text(drop_in_content)

    print(f'  Worker CPUs: {cpu_str}  (reserved: {sorted(reserved)})')
    print(f'  CPU affinity drop-ins written for {len(units)} service units')

    # Disable hf-timestd's affinity watcher — wd-ctl owns all affinity now.
    affinity_watcher = Path('/etc/systemd/system/timestd-radiod-affinity.path')
    if affinity_watcher.exists():
        subprocess.run(['systemctl', 'disable', '--now',
                        'timestd-radiod-affinity.path'],
                       capture_output=True)
        print('  Disabled timestd-radiod-affinity.path (wd-ctl owns affinity)')


def _load_deps():
    """Return a ConfigParser loaded with deps.conf."""
    import configparser as _cp
    dcfg = _cp.ConfigParser()
    dcfg.read(_SCRIPT_DIR.parent / 'deps.conf')
    return dcfg


def _ensure_onion_src(url: str, pinned: str, src_dir: Path) -> 'Path | None':
    """Clone onion source if absent and verify pinned commit.

    onion is a C library build-dep of ka9q-web — its coordinates live inside
    [ka9q-web] in deps.conf, not as a standalone section.
    """
    import subprocess

    if not src_dir.exists():
        print(f'  Cloning onion → {src_dir} ...')
        result = subprocess.run(['git', 'clone', url, str(src_dir)],
                                capture_output=True, text=True)
        if result.returncode != 0:
            print(f'  ERROR cloning onion: {result.stderr.strip()}', file=sys.stderr)
            return None
        if pinned:
            subprocess.run(['git', '-C', str(src_dir), 'checkout', pinned],
                           capture_output=True)

    if pinned:
        result = subprocess.run(
            ['git', '-c', f'safe.directory={src_dir}',
             '-C', str(src_dir), 'rev-parse', 'HEAD'],
            capture_output=True, text=True,
        )
        current = result.stdout.strip()
        if current and not current.startswith(pinned[:12]):
            print(f'  WARNING: onion at {current[:12]}, ka9q-web expects {pinned[:12]}')
            print(f'  To update: cd {src_dir} && git checkout {pinned}')
            print(f'  Then rebuild: cd build && cmake .. && make && sudo make install')
        else:
            print(f'  onion source: OK at {current[:12]}')

    return src_dir


def _build_onion(src_dir: Path) -> bool:
    """Configure and build the onion HTTP library in-tree.

    Installs to /usr/local (lib + headers). Returns True on success.
    Safe to call repeatedly — skips if already built (libonion present).
    """
    import subprocess

    lib_path = Path('/usr/local/lib/libonion.so')
    if lib_path.exists():
        print('  onion: already installed')
        return True

    build_dir = src_dir / 'build'
    build_dir.mkdir(exist_ok=True)
    print(f'  Configuring onion in {build_dir} ...')
    result = subprocess.run(
        ['cmake', '..', '-DCMAKE_INSTALL_PREFIX=/usr/local',
         '-DHAVE_SQLITE3=OFF', '-DHAVE_REDIS=OFF', '-DHAVE_HIREDIS=OFF',
         '-DHAVE_JPEG=OFF', '-DHAVE_PAM=OFF', '-DHAVE_SYSTEMD=OFF',
         '-DHAVE_XML2=OFF', '-DONION_USE_SSL=ON'],
        cwd=str(build_dir), capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f'  ERROR: onion cmake failed:\n{result.stderr.strip()}', file=sys.stderr)
        return False

    import os
    nproc = str(os.cpu_count() or 2)
    print(f'  Building onion (make -j{nproc}) ...')
    result = subprocess.run(['make', f'-j{nproc}'], cwd=str(build_dir),
                            capture_output=True, text=True)
    if result.returncode != 0:
        print(f'  ERROR: onion build failed:\n{result.stderr[-800:]}', file=sys.stderr)
        return False

    result = subprocess.run(['make', 'install'], cwd=str(build_dir),
                            capture_output=True, text=True)
    if result.returncode != 0:
        print(f'  ERROR: onion install failed:\n{result.stderr.strip()}', file=sys.stderr)
        return False

    # Refresh linker cache so ka9q-web can find libonion at runtime
    subprocess.run(['ldconfig'], capture_output=True)
    print('  onion: built and installed')
    return True


def _build_ka9q_web(src_dir: Path) -> bool:
    """Build and install ka9q-web. Returns True on success.

    Requires onion headers + lib to already be installed system-wide.
    Safe to call repeatedly — skips if binary already present.
    """
    import os
    import subprocess

    binary = Path('/usr/local/sbin/ka9q-web')
    if binary.exists():
        print('  ka9q-web: binary already installed')
        return True

    nproc = str(os.cpu_count() or 2)
    print(f'  Building ka9q-web (make -j{nproc}) ...')
    result = subprocess.run(['make', f'-j{nproc}'], cwd=str(src_dir),
                            capture_output=True, text=True)
    if result.returncode != 0:
        print(f'  ERROR: ka9q-web build failed:\n{result.stderr[-800:]}', file=sys.stderr)
        return False

    result = subprocess.run(['make', 'install'], cwd=str(src_dir),
                            capture_output=True, text=True)
    if result.returncode != 0:
        print(f'  ERROR: ka9q-web install failed:\n{result.stderr.strip()}', file=sys.stderr)
        return False

    print('  ka9q-web: built and installed')
    return True


def _ensure_git_repo(section: str, dcfg) -> Path | None:
    """Clone a git dep from deps.conf if absent; verify pinned commit; return src_dir."""
    import subprocess

    url        = dcfg.get(section, 'url', fallback='').strip()
    pinned     = dcfg.get(section, 'commit', fallback='').strip()
    install_to = dcfg.get(section, 'install_to', fallback='').strip()

    if not url or not install_to:
        print(f'  ERROR: [{section}] missing url/install_to in deps.conf', file=sys.stderr)
        return None

    src_dir = Path(install_to)

    if not src_dir.exists():
        print(f'  Cloning {section} → {src_dir} ...')
        result = subprocess.run(['git', 'clone', url, str(src_dir)],
                                capture_output=True, text=True)
        if result.returncode != 0:
            print(f'  ERROR cloning {section}: {result.stderr.strip()}', file=sys.stderr)
            return None
        if pinned:
            subprocess.run(
                ['git', '-C', str(src_dir), 'checkout', pinned],
                capture_output=True,
            )

    # Verify commit
    if pinned:
        result = subprocess.run(
            ['git', '-c', f'safe.directory={src_dir}',
             '-C', str(src_dir), 'rev-parse', 'HEAD'],
            capture_output=True, text=True,
        )
        current = result.stdout.strip()
        if current and not current.startswith(pinned[:12]):
            print(f'  WARNING: {section} source at {current[:12]}, '
                  f'deps.conf pins {pinned[:12]}')
            print(f'  To update: cd {src_dir} && git checkout {pinned} && make && sudo make install')
        else:
            print(f'  {section} source: OK at {current[:12]}')

    return src_dir


def _apply_ka9q_web(config) -> None:
    """Deploy one ka9q-web instance per unique local KA9Q radiod.

    Each instance gets:
      /etc/wsprdaemon/env/wd-ka9q-web@<radiod_name>.env  — KA9Q_WEB_STATUS + KA9Q_WEB_PORT
      wd-ka9q-web@<radiod_name>.service                  — started via systemctl

    onion is built first (if needed) because ka9q-web links against it.
    """
    import subprocess

    dcfg = _load_deps()

    # --- Ensure onion (build-time library dep of ka9q-web) is present and built ---
    # onion_src/onion_commit/onion_url live inside [ka9q-web] in deps.conf, not as
    # a standalone section, because onion is a library — not a service.
    print('  Checking onion (ka9q-web build dep) ...')
    kw_sect   = dcfg['ka9q-web'] if dcfg.has_section('ka9q-web') else {}
    onion_url = kw_sect.get('onion_url', '').strip()
    onion_pin = kw_sect.get('onion_commit', '').strip()
    onion_src = kw_sect.get('onion_src', '').strip()
    if not onion_url or not onion_src:
        print('  ERROR: onion_url/onion_src missing from [ka9q-web] in deps.conf',
              file=sys.stderr)
        return
    onion_dir = _ensure_onion_src(onion_url, onion_pin, Path(onion_src))
    if onion_dir is None:
        return
    if not _build_onion(onion_dir):
        return

    # --- Ensure ka9q-web is present and built ---
    print('  Checking ka9q-web ...')
    kw_dir = _ensure_git_repo('ka9q-web', dcfg)
    if kw_dir is None:
        return
    if not _build_ka9q_web(kw_dir):
        return

    # --- Collect unique *local* radiod names (stable name-sort, same as hf-timestd) ---
    # Remote radiods have their own host; no point running a web UI here for them.
    seen: set = set()
    instances: list = []
    for rx in sorted(config.receivers.values(), key=lambda r: r.name):
        if rx.receiver_type not in ('ka9q',):
            continue
        if rx.locality != 'local':
            continue
        if not rx.radiod_name or rx.radiod_name in seen:
            continue
        seen.add(rx.radiod_name)
        instances.append(rx.radiod_name)

    if not instances:
        print('  ka9q-web: no KA9Q receivers found — skipping')
        return

    base_port = config.ka9q_web.base_port
    env_dir   = Path('/etc/wsprdaemon/env')

    for i, radiod_name in enumerate(instances):
        port        = base_port + i
        status_addr = f'{radiod_name}-status.local'
        print(f'\n  --- ka9q-web instance: {radiod_name} ---')
        print(f'  status: {status_addr}   port: {port}')

        env_path = env_dir / f'wd-ka9q-web@{radiod_name}.env'
        env_path.write_text(
            f'KA9Q_WEB_STATUS={status_addr}\n'
            f'KA9Q_WEB_PORT={port}\n'
        )
        print(f'  env:    {env_path}')

        svc = f'wd-ka9q-web@{radiod_name}.service'
        result = subprocess.run(
            ['systemctl', 'enable', '--now', svc],
            capture_output=True, text=True,
        )
        if result.returncode == 0:
            print(f'  Started: {svc}')
        else:
            print(f'  Failed to start {svc}: {result.stderr.strip()}')


def _manage_radiod(conf_name: str) -> None:
    """Ensure radiod@<conf_name>.service is running with its current config.

    Logic:
      1. Verify the ka9q-radio source tree is at the pinned commit (deps.conf).
      2. If radiod is not running → start it.
      3. If radiod is running but /etc/radio/radiod@<conf_name>.conf was modified
         after the service last started → restart it.
    """
    import calendar
    import configparser
    import subprocess
    from datetime import datetime

    svc       = f'radiod@{conf_name}.service'
    conf_file = Path(f'/etc/radio/radiod@{conf_name}.conf')

    print(f'\n--- radiod: {svc} ---')

    # --- Check source commit against deps.conf pin ---
    deps_file = _SCRIPT_DIR.parent / 'deps.conf'
    if deps_file.exists():
        cfg = configparser.ConfigParser()
        cfg.read(deps_file)
        if 'ka9q-radio' in cfg:
            pinned     = cfg['ka9q-radio'].get('commit', '').strip()
            src_dir    = cfg['ka9q-radio'].get('install_to', '').strip()
            if pinned and src_dir and Path(src_dir).is_dir():
                result = subprocess.run(
                    ['git', '-c', f'safe.directory={src_dir}',
                     '-C', src_dir, 'rev-parse', 'HEAD'],
                    capture_output=True, text=True
                )
                current = result.stdout.strip()
                if current and not current.startswith(pinned[:8]):
                    print(f'  WARNING: ka9q-radio source at {current[:12]}, '
                          f'deps.conf pins {pinned[:12]}')
                    print(f'  To update: cd {src_dir} && git checkout {pinned} && make && sudo make install')
                else:
                    print(f'  ka9q-radio source: OK at {current[:12]}')

    if not conf_file.exists():
        print(f'  radiod config not found: {conf_file}')
        return

    conf_mtime = conf_file.stat().st_mtime

    # --- Get service state and start time ---
    result = subprocess.run(
        ['systemctl', 'show', svc,
         '--property=ActiveState,ExecMainStartTimestamp'],
        capture_output=True, text=True
    )
    props = {}
    for line in result.stdout.splitlines():
        k, _, v = line.partition('=')
        props[k.strip()] = v.strip()

    active_state = props.get('ActiveState', 'inactive')
    start_ts_str = props.get('ExecMainStartTimestamp', '')

    # Parse "Wed 2026-04-01 21:54:47 UTC" → epoch
    start_ts = 0
    if start_ts_str:
        for fmt in ('%a %Y-%m-%d %H:%M:%S %Z', '%a %Y-%m-%d %H:%M:%S'):
            try:
                dt       = datetime.strptime(start_ts_str.strip(), fmt)
                start_ts = calendar.timegm(dt.timetuple())
                break
            except ValueError:
                continue

    if active_state == 'active' and start_ts:
        if conf_mtime > start_ts:
            conf_dt  = datetime.utcfromtimestamp(conf_mtime).strftime('%H:%M:%S UTC')
            start_dt = datetime.utcfromtimestamp(start_ts).strftime('%H:%M:%S UTC')
            print(f'  Config changed ({conf_dt}) after last start ({start_dt}) — restarting')
            result = subprocess.run(
                ['systemctl', 'restart', svc],
                capture_output=True, text=True
            )
            if result.returncode == 0:
                print(f'  Restarted: {svc}')
            else:
                print(f'  Restart failed: {result.stderr.strip()}')
        else:
            print(f'  Running and config is current — no action needed')
    else:
        print(f'  State: {active_state} — starting')
        result = subprocess.run(
            ['systemctl', 'start', svc],
            capture_output=True, text=True
        )
        if result.returncode == 0:
            print(f'  Started: {svc}')
        else:
            print(f'  Failed to start: {result.stderr.strip()}')


def _grid_to_latlon(grid: str) -> tuple:
    """Convert Maidenhead grid square to approximate (lat, lon) center point."""
    g = grid.strip()
    if len(g) < 4:
        return (0.0, 0.0)
    try:
        lon = (ord(g[0].upper()) - ord('A')) * 20.0 - 180.0
        lat = (ord(g[1].upper()) - ord('A')) * 10.0 - 90.0
        lon += int(g[2]) * 2.0
        lat += int(g[3]) * 1.0
        if len(g) >= 6:
            # Subsquare letters may be upper or lower case
            lon += (ord(g[4].lower()) - ord('a')) * (2.0 / 24.0) + (1.0 / 24.0)
            lat += (ord(g[5].lower()) - ord('a')) * (1.0 / 24.0) + (0.5 / 24.0)
        else:
            lon += 1.0
            lat += 0.5
        return (round(lat, 4), round(lon, 4))
    except (IndexError, ValueError, TypeError):
        return (0.0, 0.0)


def _build_timestd_toml(call: str, grid: str, lat: float, lon: float,
                        radiod_status: str, htd) -> str:
    """Generate timestd-config.toml content for one radiod instance."""
    rtp_accuracy = '0.001' if htd.timing_authority in ('rtp', 'fusion') else '1.0'

    channels = [
        (2500000,  'WWV 2.5 MHz'),
        (3330000,  'CHU 3.33 MHz'),
        (5000000,  'WWV 5 MHz'),
        (7850000,  'CHU 7.85 MHz'),
        (10000000, 'WWV 10 MHz'),
        (14670000, 'CHU 14.67 MHz'),
        (15000000, 'WWV 15 MHz'),
        (20000000, 'WWV 20 MHz'),
        (25000000, 'WWV 25 MHz'),
    ]
    ch_blocks = '\n'.join(
        f'[[recorder.channel_group.timestd.channels]]\n'
        f'frequency_hz = {freq}\n'
        f'description  = "{desc}"\n'
        for freq, desc in channels
    )

    uploader_enabled  = str(htd.uploader_enabled).lower()
    physics_products  = str(htd.physics_enabled).lower()
    realtime_iono     = str(htd.physics_enabled).lower()
    archive_root_line = (f'archive_root         = "{htd.archive_path}"'
                         if htd.archive_path else
                         '# archive_root       = "/mnt/external/timestd-archive"  ; uncomment to enable')

    return f"""\
# Auto-generated by wd-ctl apply — do not edit manually.
# Source of truth: /etc/wsprdaemon/wsprdaemon.conf

[station]
callsign      = "{call}"
grid_square   = "{grid}"
id            = ""
instrument_id = ""
description   = "wsprdaemon station {call}"
latitude      = {lat}
longitude     = {lon}

[ka9q]
status_address       = "{radiod_status}"
auto_create_channels = true
source               = "radiod"

[recorder]
engine               = "radiod"
mode                 = "production"
compression          = "{htd.compression}"
recording_interval   = 60
continuous           = true
tiered_storage       = true
# storage_quota: start deleting oldest data when disk reaches this %.
storage_quota        = "{htd.storage_quota}"
# raw_buffer_min_days: keep at least this many UTC days of raw IQ in the pipeline buffer.
# Today and yesterday are always preserved regardless of this value.
raw_buffer_min_days  = 1
{archive_root_line}

[recorder.channel_defaults]
preset      = "iq"
sample_rate = 24000
agc         = 0
gain        = 60
encoding    = "F32"

{ch_blocks}
[metrology]
# physics_products: enable tick_phase, test_signal, detection_attempts, all_arrivals writers.
# Set false on resource-constrained hardware; core timing pipeline is unaffected.
physics_products = {physics_products}

# realtime_iono: fetch WAM-IPE + GIRO ionospheric data in real time.
# When false, propagation model uses climatological fallback only.
realtime_iono = {realtime_iono}

[timing]
authority                = "{htd.timing_authority}"
rtp_expected_accuracy_ms = {rtp_accuracy}
always_run_fusion        = false

[uploader]
enabled = {uploader_enabled}

[gnss_vtec]
enabled = false
host    = ""
port    = 0

[logging]
level          = "INFO"
console_output = false
file_output    = true

[monitoring]
enable_metrics = false

[web_ui]
port             = 8000
refresh_interval = 10
"""


def _build_timestd_env(instance: str, data_root: str, webui_port: int) -> str:
    """Generate /etc/hf-timestd/{instance}/environment content."""
    return f"""\
TIMESTD_INSTANCE={instance}
TIMESTD_MODE=production
TIMESTD_DATA_ROOT={data_root}
TIMESTD_LOG_DIR=/var/log/hf-timestd
TIMESTD_CONFIG=/etc/hf-timestd/{instance}/timestd-config.toml
TIMESTD_PROJECT=/opt/hf-timestd
TIMESTD_INSTALL_DIR=/opt/hf-timestd
TIMESTD_WEBUI=/opt/hf-timestd/web-api
TIMESTD_VENV=/opt/hf-timestd/venv
TIMESTD_LOG_LEVEL=INFO
TIMESTD_WEBUI_PORT={webui_port}
"""


def _apply_rac(config) -> None:
    """Install the Remote Access Channel (RAC) frpc service.

    Port strategy:
      35735 — legacy frps (no auth, no TLS); v3 clients and any v4 without rac_token
      35736 — frps-secure (token auth + TLS);  v4 clients with rac_token set

    Writes:
      /etc/wsprdaemon/frpc.toml      — template (serverAddr substituted at runtime)
      /opt/wsprdaemon/bin/wd-rac-connect — failover launcher script
      /etc/systemd/system/wd-remote-access.service

    Does NOT enable or start the service — RAC runs independently of wd-ctl.

    Failover logic (when rac_fallback_server is set):
      Each time systemd launches the service, wd-rac-connect probes the primary
      host first; if unreachable it tries the fallback.  systemd Restart=always
      drives the retry loop so the probe runs again on every restart, which means
      the client will naturally switch back to the primary once it recovers.
    """
    import platform
    import subprocess
    import tarfile
    import tempfile
    import urllib.request

    rac_str = config.rac
    if not rac_str:
        return
    try:
        rac = int(rac_str)
    except ValueError:
        print(f'  ERROR: rac = "{rac_str}" is not a valid integer', file=sys.stderr)
        return

    # Station call sign — first non-merge receiver's call
    call = ''
    for rx in sorted(config.receivers.values(), key=lambda r: r.name):
        if not rx.is_merge and rx.call:
            call = rx.call
            break

    ssh_port      = 35800 + rac
    web_port      = ssh_port + 10000
    ka9q_web_port = config.ka9q_web.base_port

    # Secure port if rac_token is set; legacy port otherwise.
    has_token   = bool(config.rac_token)
    server_port = 35736 if has_token else 35735
    primary     = config.rac_server or 'remote.wsprdaemon.org'
    fallback    = config.rac_fallback_server

    print(f'  RAC channel: {rac}  SSH→{ssh_port}  web→{web_port}')
    print(f'  Station: {call}  primary: {primary}:{server_port}'
          + (f'  fallback: {fallback}:{server_port}' if fallback else ''))
    if has_token:
        print(f'  Auth: token + TLS (frps-secure port {server_port})')
    else:
        print(f'  Auth: none (legacy port {server_port}) — set rac_token to enable secure mode')

    # --- Ensure frpc binary is present ---
    frpc_version = '0.64.0'
    frpc_bin     = Path('/opt/wsprdaemon/bin/frpc')
    if frpc_bin.exists():
        print(f'  frpc: already present at {frpc_bin}')
    else:
        machine = platform.machine().lower()
        arch = 'arm64' if machine in ('aarch64', 'arm64') else 'amd64'
        tarball_name = f'frp_{frpc_version}_linux_{arch}.tar.gz'
        url = (f'https://github.com/fatedier/frp/releases/download/'
               f'v{frpc_version}/{tarball_name}')
        print(f'  Downloading frpc {frpc_version} ({arch}) ...')
        frpc_bin.parent.mkdir(parents=True, exist_ok=True)
        try:
            with tempfile.TemporaryDirectory() as tmp:
                tarball = Path(tmp) / tarball_name
                urllib.request.urlretrieve(url, str(tarball))
                with tarfile.open(str(tarball), 'r:gz') as tf:
                    inner  = f'frp_{frpc_version}_linux_{arch}/frpc'
                    member = tf.getmember(inner)
                    member.name = 'frpc'
                    tf.extract(member, path=str(frpc_bin.parent))
            frpc_bin.chmod(0o755)
            print(f'  frpc installed: {frpc_bin}')
        except Exception as exc:
            print(f'  ERROR downloading frpc: {exc}', file=sys.stderr)
            print(f'  Install manually: extract frpc from {tarball_name} → {frpc_bin}',
                  file=sys.stderr)
            return

    # --- Build the frpc.toml template ---
    # serverAddr is a placeholder; wd-rac-connect substitutes the actual host
    # at runtime so the same template drives both primary and fallback configs.
    # Derive user prefix from SSH pubkey (sha256[:16]) for per-client plugin auth
    user_prefix = ''
    if has_token:
        import hashlib as _hl
        for _pub in ['/home/wsprdaemon/.ssh/id_ed25519.pub',
                     '/home/wsprdaemon/.ssh/id_rsa.pub',
                     str(Path.home() / '.ssh/id_ed25519.pub'),
                     str(Path.home() / '.ssh/id_rsa.pub')]:
            if Path(_pub).exists():
                _line = Path(_pub).read_text().strip()
                user_prefix = _hl.sha256((_line + '\n').encode()).hexdigest()[:16]
                break
    auth_lines = (
        f'\nuser = "{user_prefix}"\n'
        f'\n[auth]\nmethod = "token"\ntoken  = "{config.rac_token}"\n'
        if has_token else ''
    )
    if has_token:
        ca_path = config.rac_tls_ca or ''
        if not ca_path:
            # Default: look for the gw2 cert we save during wd-ctl apply
            default_ca = Path('/etc/wsprdaemon/gw2-ca.crt')
            if default_ca.exists():
                ca_path = str(default_ca)
        if ca_path:
            tls_lines = (
                f'\n[transport]\n'
                f'tls.enable = true\n'
                f'tls.trustedCaFile = "{ca_path}"\n'
            )
        else:
            # Let's Encrypt cert on server — system CA bundle is sufficient
            tls_lines = (
                '\n[transport]\n'
                'tls.enable = true\n'
            )
    else:
        tls_lines = ''
    frpc_conf = Path('/etc/wsprdaemon/frpc.toml')
    new_toml = (
        f'# Auto-generated by wd-ctl apply — do not edit manually.\n'
        f'# Source of truth: /etc/wsprdaemon/wsprdaemon.conf  [general] rac = {rac}\n'
        f'# serverAddr is replaced at runtime by wd-rac-connect for failover support.\n'
        f'\n'
        f'serverAddr = "{primary}"\n'
        f'serverPort = {server_port}\n'
        + auth_lines
        + tls_lines +
        f'\n'
        f'[[proxies]]\n'
        f'name       = "{call}"\n'
        f'type       = "tcp"\n'
        f'localIP    = "127.0.0.1"\n'
        f'localPort  = 22\n'
        f'remotePort = {ssh_port}\n'
        f'\n'
        f'[[proxies]]\n'
        f'name       = "{call}-WEB"\n'
        f'type       = "tcp"\n'
        f'localIP    = "127.0.0.1"\n'
        f'localPort  = {ka9q_web_port}\n'
        f'remotePort = {web_port}\n'
    )
    old_toml = frpc_conf.read_text() if frpc_conf.exists() else ''
    toml_changed = new_toml != old_toml
    frpc_conf.write_text(new_toml)
    print(f'  frpc config: {frpc_conf}{"  (updated)" if toml_changed else "  (unchanged)"}')

    # --- Write the failover launcher script ---
    # Uses bash /dev/tcp for TCP probing (no nc/curl dependency).
    # exec replaces the shell with frpc so systemd tracks the right PID.
    # When frpc exits (server gone), systemd Restart=always re-runs the script,
    # which re-probes — so the client automatically switches back to the primary
    # once it recovers, without any timer or polling loop inside the script.
    connector = Path('/opt/wsprdaemon/bin/wd-rac-connect')
    fallback_block = ''
    if fallback:
        fallback_block = (
            f'\n'
            f'elif _host_alive "{fallback}" "{server_port}"; then\n'
            f'    logger -t wd-rac "primary {primary} unreachable — connecting to fallback {fallback}:{server_port}"\n'
            f'    sed "s|^serverAddr = .*|serverAddr = \\"{fallback}\\"|" \\\n'
            f'        /etc/wsprdaemon/frpc.toml > "$FALLBACK_CONF"\n'
            f'    exec "{frpc_bin}" -c "$FALLBACK_CONF"\n'
        )
    connector.write_text(
        f'#!/bin/bash\n'
        f'# wd-rac-connect — frpc launcher with gateway failover\n'
        f'# Generated by wd-ctl apply — do not edit manually.\n'
        f'\n'
        f'FALLBACK_CONF=/run/wsprdaemon/frpc-fallback.toml\n'
        f'\n'
        f'# Probe a TCP port — 5s timeout so TLS servers do not stall the probe.\n'
        f'_host_alive() {{\n'
        f'    timeout 5 bash -c "echo > /dev/tcp/$1/$2" 2>/dev/null\n'
        f'}}\n'
        f'\n'
        f'if _host_alive "{primary}" "{server_port}"; then\n'
        f'    logger -t wd-rac "connecting to primary {primary}:{server_port}"\n'
        f'    exec "{frpc_bin}" -c /etc/wsprdaemon/frpc.toml\n'
        + fallback_block +
        f'else\n'
        f'    logger -t wd-rac "no gateway reachable — will retry via systemd restart"\n'
        f'    exit 1\n'
        f'fi\n'
    )
    connector.chmod(0o755)
    print(f'  Launcher: {connector}')

    # --- Install wd-remote-access.service ---
    # RestartSec=30: back-off between retries / failover probe interval.
    # StartLimitIntervalSec=0: unlimited restarts (gateway may be down a long time).
    svc_path = Path('/etc/systemd/system/wd-remote-access.service')
    svc_path.write_text(
        f'# Auto-generated by wd-ctl apply — do not edit manually.\n'
        f'[Unit]\n'
        f'Description=wsprdaemon Remote Access Channel {rac} ({call} → {primary}:{server_port})\n'
        f'After=network-online.target\n'
        f'Wants=network-online.target\n'
        f'\n'
        f'[Service]\n'
        f'User=wsprdaemon\n'
        f'RuntimeDirectory=wsprdaemon\n'
        f'RuntimeDirectoryPreserve=yes\n'
        f'ExecStart=/opt/wsprdaemon/bin/wd-rac-connect\n'
        f'Restart=always\n'
        f'RestartSec=30\n'
        f'StartLimitIntervalSec=0\n'
        f'\n'
        f'[Install]\n'
        f'WantedBy=multi-user.target\n'
    )
    print(f'  Service unit: {svc_path}')

    subprocess.run(['systemctl', 'daemon-reload'], capture_output=True)

    svc = 'wd-remote-access.service'
    is_active = subprocess.run(
        ['systemctl', 'is-active', '--quiet', svc],
        capture_output=True,
    ).returncode == 0

    if not is_active:
        result = subprocess.run(
            ['systemctl', 'enable', '--now', svc],
            capture_output=True, text=True,
        )
        if result.returncode == 0:
            print(f'  Service: {svc} enabled and started')
        else:
            print(f'  ERROR: failed to start {svc}: {result.stderr.strip()}', file=sys.stderr)
    elif toml_changed:
        result = subprocess.run(
            ['systemctl', 'restart', svc],
            capture_output=True, text=True,
        )
        if result.returncode == 0:
            print(f'  Service: {svc} restarted (config changed)')
        else:
            print(f'  ERROR: failed to restart {svc}: {result.stderr.strip()}', file=sys.stderr)
    else:
        print(f'  Service: {svc} running, config unchanged — no restart needed')

    print(f'  SSH access:  ssh -p {ssh_port} {call}@{primary}')


def _apply_hf_timestd(config) -> None:
    """Ensure hf-timestd is installed and running.

    hf-timestd is a single global instance (one config, one set of services).
    It connects to the primary local KA9Q radiod's status stream.
    Config paths used by deploy.sh:
      /etc/hf-timestd/timestd-config.toml  — generated from wsprdaemon.conf
      /etc/hf-timestd/environment           — instance env vars
    """
    import configparser as _cp
    import subprocess

    htd = config.hf_timestd

    # Find the primary local KA9Q radiod (first by name-sort)
    primary_radiod = None
    primary_call   = ''
    primary_grid   = ''
    for rx in sorted(config.receivers.values(), key=lambda r: r.name):
        if rx.receiver_type not in ('ka9q',) or rx.locality != 'local':
            continue
        if not rx.radiod_name:
            continue
        primary_radiod = rx.radiod_name
        primary_call   = rx.call or ''
        primary_grid   = rx.grid or ''
        break

    if not primary_radiod:
        print('  hf-timestd: no local KA9Q radiod found — skipping')
        return

    # Fall back to any non-merge receiver for call/grid if needed
    if not primary_call:
        for rx in config.receivers.values():
            if not rx.is_merge and rx.call:
                primary_call, primary_grid = rx.call, rx.grid
                break

    # Verify/clone hf-timestd source
    hft_dir = _ensure_git_repo('hf-timestd', _load_deps())
    if hft_dir is None:
        return

    deploy_sh = hft_dir / 'scripts' / 'deploy.sh'
    if not deploy_sh.exists():
        print(f'  ERROR: deploy.sh not found at {deploy_sh}', file=sys.stderr)
        return

    # Write config before deploy.sh runs so it skips the interactive wizard
    conf_dir = Path('/etc/hf-timestd')
    conf_dir.mkdir(parents=True, exist_ok=True)

    lat, lon          = _grid_to_latlon(primary_grid)
    radiod_status     = f'{primary_radiod}-status.local'
    data_root         = '/var/lib/timestd'
    webui_port        = 8000

    toml_path = conf_dir / 'timestd-config.toml'
    toml_path.write_text(
        _build_timestd_toml(primary_call, primary_grid, lat, lon, radiod_status, htd)
    )
    print(f'  radiod:  {primary_radiod}  ({radiod_status})')
    print(f'  config:  {toml_path}')

    env_path = conf_dir / 'environment'
    env_path.write_text(_build_timestd_env(primary_radiod, data_root, webui_port))
    print(f'  env:     {env_path}')

    print('  Running deploy.sh --yes ...')
    result = subprocess.run(
        ['bash', str(deploy_sh), '--yes'],
        cwd=str(hft_dir),
    )
    if result.returncode != 0:
        print(f'  WARNING: deploy.sh exited {result.returncode}', file=sys.stderr)
    else:
        print('  hf-timestd deployed')

    # --- Apply physics_enabled policy ---
    # deploy.sh always enables everything; enforce the operator's choice here.
    physics_units = [
        'timestd-physics.service',
        'timestd-ionex-download.timer',
        'timestd-ionex-download.service',
        'timestd-iono-reanalysis.timer',
        'timestd-iono-reanalysis.service',
        'timestd-chrony-monitor.timer',
        'timestd-chrony-monitor.service',
    ]
    if htd.physics_enabled:
        print('  physics_enabled = true — enabling ionospheric pipeline')
        subprocess.run(['systemctl', 'enable', '--now'] + physics_units,
                       capture_output=True)
    else:
        print('  physics_enabled = false — disabling ionospheric pipeline')
        subprocess.run(['systemctl', 'disable', '--now'] + physics_units,
                       capture_output=True)


def cmd_apply(args):
    """Generate env files from config, install units, and reconcile services."""
    import shutil
    import subprocess

    # --- Parse /etc/wsprdaemon/wsprdaemon.conf (v4 INI — single source of truth) ---
    v4_ini = Path('/etc/wsprdaemon/wsprdaemon.conf')
    if not v4_ini.exists():
        print(f'Error: config not found: {v4_ini}', file=sys.stderr)
        print('Create /etc/wsprdaemon/wsprdaemon.conf to get started.', file=sys.stderr)
        return 1

    print(f'Parsing config: {v4_ini}')
    config = parse_v4_config(str(v4_ini))

    conf_dir = Path('/etc/wsprdaemon')
    env_dir  = conf_dir / 'env'
    try:
        env_dir.mkdir(parents=True, exist_ok=True)
    except PermissionError:
        print('Error: need root to write to /etc/wsprdaemon. Run with sudo.',
              file=sys.stderr)
        return 1

    written = generate_all_env_files(config, env_dir)
    print(f'  Env files: {len(written)} files in {env_dir}/')

    # --- Install systemd unit templates ---
    # Must happen before any peer-service blocks that call systemctl enable.
    unit_src = _SCRIPT_DIR.parent / 'systemd'
    unit_dst = Path('/etc/systemd/system')
    installed_units = []
    for unit_file in unit_src.glob('*.service'):
        dst = unit_dst / unit_file.name
        shutil.copy2(unit_file, dst)
        installed_units.append(unit_file.name)
    for unit_file in unit_src.glob('*.target'):
        dst = unit_dst / unit_file.name
        shutil.copy2(unit_file, dst)
        installed_units.append(unit_file.name)
    for unit_file in unit_src.glob('*.timer'):
        dst = unit_dst / unit_file.name
        shutil.copy2(unit_file, dst)
        installed_units.append(unit_file.name)
    print(f'  Units installed: {", ".join(sorted(installed_units))}')

    # --- hf-timestd integration ---
    if config.hf_timestd.enabled:
        print('\n--- hf-timestd ---')
        _apply_hf_timestd(config)

    # --- ka9q-web integration ---
    if config.ka9q_web.enabled:
        print('\n--- ka9q-web ---')
        _apply_ka9q_web(config)

    # --- Remote Access Channel (RAC) ---
    if config.rac:
        print('\n--- Remote Access Channel (RAC) ---')
        _apply_rac(config)

    # --- Install wrapper scripts ---
    sbin = Path('/usr/local/sbin')
    wrappers = ['wd-ka9q-record', 'wd-kiwi-record', 'wd-kiwi-cleanup',
                'wd-spool-clean', 'wd-decode', 'wd-post']
    for name in wrappers:
        src = _SCRIPT_DIR / name
        if src.exists():
            dst = sbin / name
            shutil.copy2(src, dst)
            dst.chmod(0o755)
    print(f'  Wrappers installed to {sbin}/')

    # --- Install Python recorder ---
    opt_bin = Path('/opt/wsprdaemon/bin')
    opt_bin.mkdir(parents=True, exist_ok=True)
    py_src = _SCRIPT_DIR / 'wd-ka9q-record.py'
    if py_src.exists():
        shutil.copy2(py_src, opt_bin / 'wd-ka9q-record.py')
    opt_lib = Path('/opt/wsprdaemon/lib')
    opt_lib.mkdir(parents=True, exist_ok=True)
    wdlib_src = _SCRIPT_DIR.parent / 'lib' / 'wdlib'
    wdlib_dst = opt_lib / 'wdlib'
    if wdlib_dst.is_symlink() or wdlib_dst.exists():
        wdlib_dst.unlink() if wdlib_dst.is_symlink() else shutil.rmtree(wdlib_dst)
    wdlib_dst.symlink_to(wdlib_src)

    # --- Calculate tmpfs size from env files ---
    # WSPR (12 kHz mono float32):  12000*60*4 = 2,880,000 bytes ≈ 3 MB/file
    # IQ   (24 kHz stereo float32): 24000*60*2*4 = 11,520,000 bytes ≈ 12 MB/file
    # File sizes (bytes → MB, ceiling):
    #   KA9Q WSPR  _usr.wav: 12000 Hz mono float32 60s  = 2,880,044 bytes ≈ 3 MB
    #   KA9Q IQ    _IQ.wav:  24000 Hz stereo float32 60s = 11,520,044 bytes ≈ 12 MB
    #   Kiwi WSPR  _usb.wav: 12000 Hz mono int16 60s    = 1,440,044 bytes ≈ 2 MB
    WSPR_MB  = 3
    IQ_MB    = 12
    KIWI_MB  = 2
    # Retention: IQ files use I1 (1-min) mode — only need 3 min.
    #            WSPR files need up to 32 min to support F30 (FST4W-1800).
    IQ_KEEP   = 3
    WSPR_KEEP = 32

    wspr_bands = iq_bands = kiwi_bands = 0
    for fp in written:
        fname = Path(fp).name
        lines = Path(fp).read_text().splitlines()
        bands_val = next((l.split('=', 1)[1] for l in lines if l.startswith('WD_BANDS=')), '')
        type_val  = next((l.split('=', 1)[1] for l in lines if l.startswith('WD_RECEIVER_TYPE=')), '')
        n = len(bands_val.split()) if bands_val.strip() else 1
        if 'wd-ka9q-record@' in fname:
            if 'wwv' in type_val.lower():
                iq_bands += n
            else:
                wspr_bands += n
        elif 'wd-kiwi-record@' in fname:
            kiwi_bands += 1

    raw_mb   = (wspr_bands * WSPR_MB + kiwi_bands * KIWI_MB) * WSPR_KEEP \
             + iq_bands * IQ_MB * IQ_KEEP
    tmpfs_mb = max(512, int(raw_mb * 1.25) + 64)
    print(f'  tmpfs size: {tmpfs_mb} MB  ({wspr_bands} WSPR bands, {iq_bands} IQ bands)')

    # --- Generate and install the systemd mount unit ---
    mount_unit = f'''\
# Auto-generated by wd-ctl apply — do not edit manually
[Unit]
Description=wsprdaemon recording spool (tmpfs)
DefaultDependencies=no
Before=local-fs.target

[Mount]
What=tmpfs
Where=/var/spool/wsprdaemon
Type=tmpfs
Options=size={tmpfs_mb}m,uid=wsprdaemon,gid=radio,mode=1775

[Install]
WantedBy=local-fs.target
'''
    mount_unit_path = Path('/etc/systemd/system/var-spool-wsprdaemon.mount')
    mount_unit_path.write_text(mount_unit)
    print(f'  Mount unit: {mount_unit_path}')

    # --- Reload systemd (needed before we can start the mount unit) ---
    subprocess.run(['systemctl', 'daemon-reload'], check=True)
    print('  systemd daemon reloaded')

    # --- Mount the tmpfs (enable for persistence across reboots) ---
    subprocess.run(['systemctl', 'enable', 'var-spool-wsprdaemon.mount'], check=True)
    result = subprocess.run(
        ['findmnt', '-t', 'tmpfs', '/var/spool/wsprdaemon'],
        capture_output=True
    )
    if result.returncode != 0:
        subprocess.run(['systemctl', 'start', 'var-spool-wsprdaemon.mount'], check=True)
        print('  Mounted tmpfs at /var/spool/wsprdaemon')
    else:
        print('  tmpfs already mounted at /var/spool/wsprdaemon')

    # --- Create spool subdirectories (tmpfs is now mounted) ---
    spool = Path('/var/spool/wsprdaemon/recording')
    spool.mkdir(parents=True, exist_ok=True)
    for rx_name, rx in config.receivers.items():
        if rx.receiver_type in ('ka9q', 'ka9q_wwv', 'kiwi'):
            rx_dir = spool / rx_name
            rx_dir.mkdir(parents=True, exist_ok=True)
            try:
                shutil.chown(str(rx_dir), user='wsprdaemon')
            except Exception:
                pass

    # --- Start/restart ka9q-record services ---
    ka9q_instances = [
        Path(f).stem.split('@')[1]
        for f in written
        if 'wd-ka9q-record@' in Path(f).name
    ]
    for instance in sorted(ka9q_instances):
        svc = f'wd-ka9q-record@{instance}.service'
        result = subprocess.run(
            ['systemctl', 'enable', '--now', svc],
            capture_output=True, text=True
        )
        if result.returncode == 0:
            print(f'  Started: {svc}')
        else:
            print(f'  Failed to start {svc}: {result.stderr.strip()}')

    # --- Start kiwi-record services ---
    kiwi_instances = [
        Path(f).stem.split('@')[1]
        for f in written
        if 'wd-kiwi-record@' in Path(f).name
    ]
    for instance in sorted(kiwi_instances):
        svc = f'wd-kiwi-record@{instance}.service'
        result = subprocess.run(
            ['systemctl', 'enable', '--now', svc],
            capture_output=True, text=True
        )
        if result.returncode == 0:
            print(f'  Started: {svc}')
        else:
            print(f'  Failed to start {svc}: {result.stderr.strip()}')

    # --- Enable spool janitor timer ---
    subprocess.run(['systemctl', 'enable', '--now', 'wd-spool-clean.timer'],
                   capture_output=True)
    print('  Spool janitor: wd-spool-clean.timer enabled')

    # --- Collect ordered list of local radiod names (stable sort by name) ---
    local_radiods: list = []
    _seen_radiods: set = set()
    for rx in sorted(config.receivers.values(), key=lambda r: r.name):
        if rx.receiver_type not in ('ka9q', 'ka9q_wwv'):
            continue
        if rx.locality != 'local' or not rx.radiod_name:
            continue
        if rx.radiod_name not in _seen_radiods:
            local_radiods.append(rx.radiod_name)
            _seen_radiods.add(rx.radiod_name)

    # --- Manage radiod service for each local radiod ---
    for radiod_name in local_radiods:
        _manage_radiod(radiod_name)

    # --- Assign CPU affinity to local radiod instances ---
    # Skip HT pairs already used by manually-managed (non-local) radiod instances.
    # This ensures wd-ctl-managed radiods don't conflict with user-managed ones.
    print('\n--- CPU affinity ---')
    ht_pairs = _get_ht_pairs()
    all_assignments = _get_radiod_cpu_assignments()
    local_radiod_set = set(local_radiods)
    print(f'  HT pairs: {[list(p) for p in ht_pairs]}')

    affinity_changed = False
    for i, radiod_name in enumerate(local_radiods):
        if i >= len(ht_pairs):
            print(f'  WARNING: no CPU pair for radiod@{radiod_name} '
                  f'(only {len(ht_pairs)} pairs on this host)', file=sys.stderr)
            continue
        pair = ht_pairs[i]   # local radiods own pairs 0, 1, 2 ... in name order
        current = all_assignments.get(radiod_name)
        if current == frozenset(pair):
            print(f'  radiod@{radiod_name}: CPUAffinity already {list(pair)} — no change')
        else:
            _apply_radiod_cpu_affinity(radiod_name, pair)
            affinity_changed = True

    if not local_radiods:
        print('  No local radiod instances configured')

    # --- Build reserved CPU set: wd-ctl radiods + user-specified extras ---
    reserved_cpus: set = set()
    for radiod_name in local_radiods:
        assigned = all_assignments.get(radiod_name) or frozenset()
        # If just assigned this session, get from ht_pairs
        if not assigned:
            idx = local_radiods.index(radiod_name)
            if idx < len(ht_pairs):
                assigned = frozenset(ht_pairs[idx])
        reserved_cpus |= set(assigned)

    # Add any CPUs reserved by the user for manually-managed services
    user_reserved = config.reserved_cpus
    if user_reserved:
        for tok in user_reserved.replace(',', ' ').split():
            try:
                reserved_cpus.add(int(tok))
            except ValueError:
                pass
        print(f'  User-reserved CPUs: {sorted(int(t) for t in user_reserved.replace(",", " ").split() if t.isdigit())}')

    # --- Write worker CPU affinity drop-ins for all managed services ---
    _apply_worker_cpu_affinity(reserved_cpus)

    # --- Reload and restart radiod if affinity changed ---
    subprocess.run(['systemctl', 'daemon-reload'], check=True)
    if affinity_changed:
        for radiod_name in local_radiods:
            result = subprocess.run(
                ['systemctl', 'restart', f'radiod@{radiod_name}.service'],
                capture_output=True, text=True
            )
            status = 'restarted' if result.returncode == 0 else f'restart failed: {result.stderr.strip()}'
            print(f'  radiod@{radiod_name}: {status}')

    print('\nApply complete. Check status with: wd-ctl status')
    return 0


def cmd_teardown(args):
    """Stop and disable all wsprdaemon-managed services, including local radiod instances."""
    import subprocess

    def _stop(units, label):
        subprocess.run(
            ['systemctl', 'stop', '--ignore-not-found'] + units,
            capture_output=True, text=True
        )
        print(f'  Stopped: {label}')

    print('Stopping wsprdaemon services...')

    # --- Recorders and decoders ---
    _stop(['wd-spool-clean.timer', 'wd-spool-clean.service'], 'spool janitor')
    _stop(['wd-ka9q-record@*', 'wd-kiwi-record@*'], 'recorders')
    _stop(['wd-decode@*', 'wd-post@*'], 'decoders / posters')
    _stop(['wd-ka9q-web@*'], 'ka9q-web instances')
    _stop(['timestd-pipeline-watchdog.timer'], 'hf-timestd watchdog')
    _stop(['timestd-core-recorder'], 'hf-timestd core recorder')
    _stop(['timestd-metrology@*'], 'hf-timestd metrology workers')
    _stop(['timestd-l2-calibration', 'timestd-fusion',
           'timestd-physics', 'timestd-web-api',
           'timestd-radiod-monitor'], 'hf-timestd pipeline services')

    # --- Local radiod instances from config ---
    v4_ini = Path('/etc/wsprdaemon/wsprdaemon.conf')
    if v4_ini.exists():
        config = parse_v4_config(str(v4_ini))
        local_radiods = []
        seen = set()
        for rx in sorted(config.receivers.values(), key=lambda r: r.name):
            if rx.receiver_type not in ('ka9q', 'ka9q_wwv'):
                continue
            if rx.locality != 'local' or not rx.radiod_name:
                continue
            if rx.radiod_name not in seen:
                local_radiods.append(rx.radiod_name)
                seen.add(rx.radiod_name)
        for radiod_name in local_radiods:
            svc = f'radiod@{radiod_name}.service'
            _stop([svc], f'radiod@{radiod_name}')
    else:
        print('  (no config found — skipping radiod stop)')

    # --- Clear failed unit state ---
    subprocess.run(['systemctl', 'reset-failed'], capture_output=True)

    print('\nTeardown complete.')
    return 0


def cmd_status(args):
    """Show status of all wsprdaemon services."""
    # Try to import systemd module
    try:
        from wdlib import systemd as sd
    except ImportError:
        print('Error: wdlib not found', file=sys.stderr)
        return 1

    print('wsprdaemon v4 service status')
    print('=' * 60)

    patterns = [
        'wd-ka9q-record@*',
        'wd-kiwi-record@*',
        'wd-decode@*',
        'wd-post@*',
        'wd-upload-*',
        'wd-ka9q-web@*',
    ]

    found_any = False
    for pattern in patterns:
        units = sd.list_units(pattern)
        if units:
            found_any = True
            for unit in units:
                active = 'active' if sd.is_active(unit) else 'inactive'
                print(f'  {unit:50s}  [{active}]')

    if not found_any:
        print('  No wsprdaemon services found.')
        print('  Run "wd-ctl apply" to start services from config.')

    return 0


def cmd_validate(args):
    """Validate config without applying."""
    conf_path = args.config or '/etc/wsprdaemon/wsprdaemon.conf'
    if not Path(conf_path).exists():
        print(f'Error: config not found: {conf_path}', file=sys.stderr)
        return 1

    print(f'Validating: {conf_path}')
    try:
        config = parse_v4_config(conf_path)
        print(f'  Receivers: {len(config.receivers)}')
        print(f'  Schedule slots: {len(config.schedule_slots)}')

        # Check for schedule errors
        errors = []
        for slot in config.schedule_slots:
            for entry in slot.entries:
                rx = config.receivers.get(entry.receiver)
                if not rx:
                    errors.append(f'Schedule references unknown receiver: {entry.receiver}')
                    continue
                # KA9Q receivers must not appear in schedule transitions
                if rx.receiver_type == 'ka9q' and slot.time != '00:00':
                    errors.append(
                        f'KA9Q receiver {entry.receiver} in time-based schedule '
                        f'at {slot.time} — KA9Q recorders run continuously and '
                        f'must not be schedule-toggled'
                    )

        if errors:
            print(f'\n  ERRORS ({len(errors)}):')
            for e in errors:
                print(f'    ! {e}')
            return 1
        else:
            print('  Config is valid.')
            return 0
    except Exception as e:
        print(f'  Parse error: {e}', file=sys.stderr)
        return 1


def cmd_verbosity(args):
    """Change log verbosity for a service."""
    print(f'verbosity {args.direction} {args.target}: not yet implemented')
    print('This will send USR1 (up) or USR2 (down) to the service MainPID.')
    return 0


def cmd_install_deps(args):
    """Install or verify external dependencies declared in deps.conf."""
    import configparser
    import subprocess

    deps_file = _SCRIPT_DIR.parent / 'deps.conf'
    if not deps_file.exists():
        print(f'Error: deps.conf not found at {deps_file}', file=sys.stderr)
        return 1

    cfg = configparser.ConfigParser()
    cfg.read(deps_file)
    errors = 0

    for dep in cfg.sections():
        dep_type   = cfg[dep].get('type', '').strip()
        url        = cfg[dep].get('url', '').strip()
        commit     = cfg[dep].get('commit', '').strip()
        install_to = cfg[dep].get('install_to', '').strip()

        print(f'\n[{dep}]  type={dep_type}  version={commit}')

        if dep_type == 'git':
            target = Path(install_to)
            if target.exists():
                current = subprocess.run(
                    ['git', '-c', f'safe.directory={target}',
                     '-C', str(target), 'rev-parse', 'HEAD'],
                    capture_output=True, text=True
                ).stdout.strip()
                if current.startswith(commit[:8]):
                    print(f'  OK — {target} at {current[:12]}')
                else:
                    print(f'  MISMATCH — have {current[:12]}, want {commit[:12]}')
                    print(f'  Run: git -C {target} fetch && git -C {target} checkout {commit}')
                    errors += 1
            else:
                print(f'  Cloning {url} → {target}')
                result = subprocess.run(
                    ['git', 'clone', url, str(target)],
                    capture_output=True, text=True
                )
                if result.returncode != 0:
                    print(f'  ERROR: {result.stderr.strip()}', file=sys.stderr)
                    errors += 1
                    continue
                result = subprocess.run(
                    ['git', '-C', str(target), 'checkout', commit],
                    capture_output=True, text=True
                )
                if result.returncode != 0:
                    print(f'  ERROR checking out {commit}: {result.stderr.strip()}',
                          file=sys.stderr)
                    errors += 1
                else:
                    print(f'  Checked out {commit[:12]}')

        elif dep_type == 'pypi':
            venv_pip = Path('/opt/wsprdaemon/venv/bin/pip')
            pip_cmd  = str(venv_pip) if venv_pip.exists() else 'pip3'
            result = subprocess.run(
                [pip_cmd, 'show', url],
                capture_output=True, text=True
            )
            if result.returncode == 0:
                installed_ver = next(
                    (l.split(':', 1)[1].strip()
                     for l in result.stdout.splitlines()
                     if l.startswith('Version:')),
                    'unknown'
                )
                if installed_ver == commit:
                    print(f'  OK — {url}=={installed_ver}')
                else:
                    print(f'  VERSION MISMATCH — have {installed_ver}, want {commit}')
                    print(f'  Run: {pip_cmd} install "{url}=={commit}"')
                    errors += 1
            else:
                print(f'  Installing {url}=={commit}')
                result = subprocess.run(
                    [pip_cmd, 'install', f'{url}=={commit}'],
                    capture_output=True, text=True
                )
                if result.returncode != 0:
                    print(f'  ERROR: {result.stderr.strip()}', file=sys.stderr)
                    errors += 1
                else:
                    print(f'  Installed')
        else:
            print(f'  Unknown dep type "{dep_type}", skipping')

    if errors:
        print(f'\ninstall-deps: {errors} error(s) — see above', file=sys.stderr)
        return 1
    print('\ninstall-deps: all dependencies satisfied')
    return 0


def main():
    parser = argparse.ArgumentParser(
        prog='wd-ctl',
        description='wsprdaemon v4 orchestrator'
    )
    sub = parser.add_subparsers(dest='command', help='Subcommand')

    # apply
    sub.add_parser('apply', help='Apply config: generate env files and reconcile services')

    # teardown
    sub.add_parser('teardown', help='Stop and disable all services')

    # status
    sub.add_parser('status', help='Show service status')

    # validate
    p_val = sub.add_parser('validate', help='Validate config')
    p_val.add_argument('-c', '--config', help='Config file path')

    # verbosity
    p_verb = sub.add_parser('verbosity', help='Change log verbosity')
    p_verb.add_argument('direction', choices=['up', 'down'])
    p_verb.add_argument('target', help='Service name or "all"')

    # install-deps
    sub.add_parser('install-deps',
                   help='Install or verify external dependencies from deps.conf')

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 1

    dispatch = {
        'apply': cmd_apply,
        'teardown': cmd_teardown,
        'status': cmd_status,
        'validate': cmd_validate,
        'verbosity': cmd_verbosity,
        'install-deps': cmd_install_deps,
    }

    return dispatch[args.command](args)


if __name__ == '__main__':
    sys.exit(main() or 0)
