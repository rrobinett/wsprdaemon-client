#!/bin/bash
# /usr/local/sbin/wd-kiwi-record
# Wrapper for kiwirecorder.py — one instance per KiwiSDR channel.
#
# kiwirecorder.py writes minute-aligned wav files using --dt-sec=60.
# Files are named: YYYYMMDDTHHMMSSz_<freq_hz>_usb.wav
# Format: PCM signed 16-bit, 12000 Hz, mono.
#
# On SIGTERM systemd sends the signal to kiwirecorder.py (via exec).
# kiwirecorder.py closes the current (truncated) wav file on exit.
# wd-kiwi-cleanup (ExecStopPost) removes the truncated partial file.

set -euo pipefail

: "${WD_RECEIVER_NAME:?WD_RECEIVER_NAME not set}"
: "${WD_KIWI_ADDRESS:?WD_KIWI_ADDRESS not set}"
: "${WD_RECEIVER_FREQ_HZ:?WD_RECEIVER_FREQ_HZ not set}"
: "${WD_RECORDING_DIR:?WD_RECORDING_DIR not set}"

KIWI_HOST="${WD_KIWI_ADDRESS%:*}"
KIWI_PORT="${WD_KIWI_ADDRESS##*:}"

# kiwirecorder.py takes frequency in kHz
FREQ_KHZ=$(awk "BEGIN { printf \"%.3f\", ${WD_RECEIVER_FREQ_HZ}/1000 }")

PASSWORD="${WD_KIWI_PASSWORD:-}"

KIWIRECORDER=/opt/wsprdaemon/kiwiclient/kiwirecorder.py

mkdir -p "${WD_RECORDING_DIR}"
cd "${WD_RECORDING_DIR}"

ARGS=(
    --server-host="${KIWI_HOST}"
    --server-port="${KIWI_PORT}"
    --freq="${FREQ_KHZ}"
    --modulation=usb
    --agc-gain=60
    --quiet
    --no_compression
    --lp-cutoff=1340
    --hp-cutoff=1660
    --dt-sec=60
    --user="wsprdaemon_v4_${WD_RECEIVER_NAME}"
)
[[ -n "${PASSWORD}" ]] && ARGS+=(--password="${PASSWORD}")

exec python3 -u "${KIWIRECORDER}" "${ARGS[@]}"
